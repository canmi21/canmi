{
	"$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxfmt/configuration_schema.json",
	"singleQuote": true,
	"trailingComma": "all",
	"printWidth": 100,
	"svelte": true,
	"ignorePatterns": [
		"repos/web/data/",
		"repos/platform/apps/data/registry/scripts/",
		"repos/platform/apps/data/secrets/",
		"**/.claude/",
		"**/contents/",
		"**/corpus/cases/",
		"**/node_modules/",
		"**/target/",
		"**/vendor/",
		"**/seam/pkgs/framework/"
	]
}
