# Every directory under repos/ is a separate repository, cloned into place. jj stops at a
# nested .jj or .git on its own, so this entry is not for jj -- it is for git, which would
# otherwise turn one into a submodule the moment `git add -A` runs in this colocated repo.
# See spec/architecture/repos.md.
repos/*/

# The one dependency this repository has: the formatter `jj fix` runs.
node_modules/

# OS
.DS_Store
