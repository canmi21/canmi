#!/usr/bin/env python3
#MISE description="The repositories: `repos list|clone|pull|push|fmt|update|clean|verify [name]`"
"""Every command here takes an optional repository name and means all of them without one.

The name is a key from repos.toml, which is the local directory: `repos pull rdm` is rdm,
`repos pull` is everything, and `workspace` is this repository. The top-level verbs are one-line
aliases onto this, so the short form is what gets typed and this file is where it lives once.

  list             what the registry holds and what is on disk
  clone            clone whatever is listed and missing
  pull             fetch, and say what moved
  push             push main
  fmt              each repository's own fmt
  update           each repository's own update, kept where its own verify still passes
  clean            each repository's own clean
  verify           each repository's own verify
  publish          one repository's own publish; a name is required
  check            the registry, the task roots and the directories still agree

pull, push and clone are jj's and the same in every repository, so they live here. What fmt,
update, clean and verify do depends on what a repository is built with, so each runs the
repository's own task, and one without it is passed over and named. Every command that changes
something takes `--dry-run` (`-n`), and every repository task it reaches takes it as well.
See spec/architecture/repos.md, "One verb, optionally one name".
"""

from __future__ import annotations

import pathlib
import re
import subprocess
import sys

sys.dont_write_bytecode = True
sys.stdout.reconfigure(line_buffering=True)

ROOT = pathlib.Path(__file__).resolve().parents[2]
REPOS = ROOT / "repos"
REGISTRY = ROOT / "repos.toml"
CONFIG = ROOT / "mise.toml"

# `directory = "user:repo"` inside the [repos] table. Read by pattern rather than with a TOML
# parser: this is one flat table, and which parser is available depends on the python mise
# happens to resolve, which is not a dependency worth taking for a line of this shape.
# Configuration this repository provides and every project below resolves by walking up. A
# project carrying its own copy is what `check` looks for: an identical one is dead weight, and
# a different one shadows this repository's silently. `.editorconfig` is the sharp case -- it
# carries `root = true`, whose whole meaning is to stop that walk -- and rustfmt likewise stops
# at the first file it finds. An `.oxlintrc.json` that `extends` this repository's is the one
# exception, since it is a difference rather than a copy; see `extends_workspace`.
# See spec/architecture/repos.md.
#
# `.gitattributes` is deliberately absent: git resolves attributes only within one worktree, so
# it never inherits and a project setting its own is correct.
INHERITED = (
	".editorconfig",
	"rustfmt.toml",
	"rust-toolchain.toml",
	".oxlintrc.json",
	".oxfmtrc.json",
	"jj.toml",
)

ENTRY = re.compile(r'^\s*([\w.-]+)\s*=\s*"([A-Za-z0-9][\w.-]*):([\w.-]+)"\s*$', re.MULTILINE)

def fail(message: str) -> "SystemExit":
	return SystemExit(f"error: {message}")


def registry() -> dict[str, tuple[str, str]]:
	"""directory -> (user, repo), in the order the file gives them."""
	if not REGISTRY.is_file():
		raise fail(f"{REGISTRY.name} does not exist")
	table = re.search(r"^\[repos\]\n((?:.*\n)*)", REGISTRY.read_text(), re.MULTILINE)
	found = {}
	for directory, user, repo in ENTRY.findall(table.group(1) if table else ""):
		if directory in found:
			raise fail(f"{REGISTRY.name} lists {directory} twice")
		found[directory] = (user, repo)
	return found


def selected(name: str | None) -> list[pathlib.Path]:
	"""The repositories a command applies to: one when named, all of them otherwise.

	**This workspace is one of them.** It has a remote, a working copy and files to format like
	any project, and leaving it out meant `push` reporting nothing to push while this very
	repository was a commit ahead. `workspace` is the name for it, matching what the tools task
	already accepted.
	"""
	listed = registry()
	if name == "workspace":
		return [ROOT]
	if name:
		if name not in listed:
			known = ", ".join(["workspace", *listed])
			raise fail(f"{REGISTRY.name} does not list {name}; the names are {known}")
		target = REPOS / name
		if not target.is_dir():
			raise fail(f"repos/{name} is listed but not cloned -- `mise run repos clone` first")
		return [target]
	return [ROOT] + [REPOS / d for d in listed if (REPOS / d).is_dir()]


def label(where: pathlib.Path) -> str:
	return "workspace" if where == ROOT else where.name


def is_repository(path: pathlib.Path) -> bool:
	return (path / ".git").exists() or (path / ".jj").exists()


def jj(*args: str, cwd: pathlib.Path, check: bool = True) -> subprocess.CompletedProcess:
	result = subprocess.run(["jj", *args], cwd=cwd, capture_output=True, text=True)
	if check and result.returncode != 0:
		sys.stderr.write(result.stderr)
		raise fail(f"jj {' '.join(args)} failed in {cwd.name}")
	return result


def task_roots() -> list[str]:
	block = re.search(r"^config_roots\s*=\s*\[(.*?)\]", CONFIG.read_text(), re.MULTILINE | re.DOTALL)
	return re.findall(r'"([^"]+)"', block.group(1)) if block else []


def command_list() -> int:
	listed = registry()
	on_disk = {p.name for p in REPOS.iterdir() if p.is_dir()} if REPOS.is_dir() else set()
	for directory, (user, repo) in listed.items():
		mark = "" if directory in on_disk else "   (not cloned)"
		print(f"{directory:<12} {user}:{repo}{mark}")
	for name in sorted(on_disk - set(listed)):
		print(f"{name:<12} on disk but not listed in {REGISTRY.name}")
	return 0


def command_clone(name: str | None, dry: bool = False) -> int:
	if name == "workspace":
		raise fail("the workspace is this checkout; there is nothing to clone")
	REPOS.mkdir(exist_ok=True)
	listed = registry()
	if name and name not in listed:
		# A name it did not know used to clone every repository instead.
		raise fail(f"{REGISTRY.name} does not list {name}; the names are {', '.join(listed)}")
	wanted = {name: listed[name]} if name else listed
	added = 0
	for directory, (user, repo) in wanted.items():
		target = REPOS / directory
		if target.exists():
			continue
		if dry:
			print(f"would clone {user}:{repo} into repos/{directory}")
			added += 1
			continue
		print(f"cloning {user}:{repo} into repos/{directory}")
		# Colocated, because the git side is what the remote and any contributor speak.
		subprocess.run(
			["jj", "git", "clone", "--colocate", f"https://github.com/{user}/{repo}.git", str(target)],
			check=True,
		)
		added += 1
	print(f"{added} {'would be cloned' if dry else 'cloned'}")
	return 0


def command_pull(name: str | None, dry: bool = False) -> int:
	"""Fetch, and say what that brought in.

	`jj git fetch` has no dry run and needs none of its own: it writes remote-tracking refs and
	nothing else -- no commit, no working copy. The dry run skips it anyway and reports the
	divergence the last fetch left, saying which it is rather than passing stale state off as
	current.
	"""
	for repo in selected(name):
		if not is_repository(repo):
			print(f"{label(repo)}: not a repository, skipped")
			continue
		if not dry:
			result = jj("git", "fetch", cwd=repo, check=False)
			if result.returncode != 0:
				print(f"{label(repo)}: fetch failed")
				sys.stderr.write(result.stderr)
				continue
		behind = jj(
			"log", "--no-graph", "-r", "main..main@origin",
			"-T", 'commit_id.short() ++ " " ++ description.first_line() ++ "\\n"',
			cwd=repo, check=False,
		).stdout.strip()
		stale = " (as of the last fetch; none run)" if dry else ""
		print(f"{label(repo)}: {'up to date' if not behind else 'behind by'}{stale}")
		for line in behind.splitlines():
			print(f"    {line}")
	return 0


def command_push(name: str | None, dry: bool = False) -> int:
	"""Push main wherever origin is behind it. A repository whose origin has no main yet -- a new
	project cloned from an empty remote -- is behind by all of it: `main@origin` names nothing
	there and is an error, where `remote_bookmarks()` is an empty set and the range is the whole
	history. The root commit is jj's, not the project's, so it is never counted."""
	for repo in selected(name):
		if not is_repository(repo):
			continue
		result = jj(
			"log", "--no-graph", "-r", 'remote_bookmarks(exact:"main", exact:"origin")..main ~ root()',
			"-T", 'commit_id.short() ++ "\\n"', cwd=repo, check=False,
		)
		if result.returncode != 0:
			print(f"{label(repo)}: cannot tell what to push")
			sys.stderr.write(result.stderr)
			continue
		ahead = result.stdout.strip()
		if not ahead:
			print(f"{label(repo)}: nothing to push")
			continue
		verb = "would push" if dry else "pushing"
		print(f"{label(repo)}: {verb} {len(ahead.splitlines())} commit(s)")
		command = ["jj", "git", "push", "--bookmark", "main"] + (["--dry-run"] if dry else [])
		subprocess.run(command, cwd=repo, check=True)
	return 0


# What each verb runs in a repository. A project's task carries the verb's own name; the
# workspace's cannot, because there the verb's name is the loop itself, so its own half lives
# under `self:` -- `.mise/tasks/self/<verb>`. `verify` is not a loop verb (`check` is), so the
# workspace's keeps its name.
OWN = {"update": "self:update", "clean": "self:clean", "fmt": "self:fmt"}


def own_task(repo: pathlib.Path, verb: str) -> str:
	if repo == ROOT:
		return f"//:{OWN.get(verb, verb)}"
	return f"//repos/{repo.name}:{verb}"


def declares(repo: pathlib.Path, verb: str) -> bool:
	"""Whether a repository has its own task for this verb, inline or as a file task."""
	task = OWN.get(verb, verb) if repo == ROOT else verb
	config = repo / "mise.toml"
	text = config.read_text() if config.is_file() else ""
	inline = f"[tasks.{task}]" in text or f'[tasks."{task}"]' in text
	return inline or (repo / ".mise" / "tasks" / task.replace(":", "/")).is_file()


def step(where: pathlib.Path, *command: str, quiet: bool = False) -> subprocess.CompletedProcess:
	"""One command, its output shown as it arrives and kept, unless only the text is asked.

	Shown as it arrives because a verify is long enough that silence reads as a hang; kept because
	the lines it failed on are repeated under the summary, where a long log would bury them.
	"""
	if quiet:
		return subprocess.run(list(command), cwd=where, capture_output=True, text=True)
	print(f"$ {' '.join(command)}")
	process = subprocess.Popen(
		list(command), cwd=where, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
	)
	seen = []
	for line in process.stdout:
		print(line, end="")
		seen.append(line)
	return subprocess.CompletedProcess(command, process.wait(), "".join(seen), "")


def symptom(output: str) -> list[str]:
	"""The lines of a failed verify worth repeating under the summary, which a long log buries."""
	lines = output.splitlines()
	marked = [line for line in lines if re.search(r"\berror\b|panicked|FAILED", line)]
	return (marked or lines)[:10]


def summary(verb: str, skipped: list[str], failed: list[str]) -> None:
	"""The part a person acts on, after every repository's own log."""
	if not (skipped or failed):
		return
	print("\n" + "-" * 72)
	if skipped:
		print(f"warning: no {verb} task of their own, so passed over: {', '.join(skipped)}")
	if failed:
		print(f"failed: {', '.join(failed)}")


def command_dispatch(verb: str, name: str | None, dry: bool = False) -> int:
	"""Each selected repository's own task for this verb, one after another and on past a failure.

	**What a verb does is the repository's to say; this only decides where to look.** A
	repository without the task is passed over and named, not failed: it has said nothing about
	this verb, and a failure belongs to a task that ran. `--dry-run` is handed on, and every
	project's task for a verb that writes takes it; `verify` writes nothing, so its dry run is this
	printing the task it would run. See spec/architecture/repos.md, "One verb, optionally one name".
	"""
	skipped, failed = [], []
	for repo in selected(name):
		if not declares(repo, verb):
			skipped.append(label(repo))
			continue
		task = own_task(repo, verb)
		if dry and verb == "verify":
			print(f"would run {task}")
			continue
		flags = ["--dry-run"] if dry else []
		print(f"\n=== {' '.join([task, *flags])} ===")
		if subprocess.run(["mise", "run", task, *flags], cwd=ROOT).returncode != 0:
			failed.append(label(repo))
	summary(verb, skipped, failed)
	return 1 if failed else 0


def snapshot(repo: pathlib.Path) -> str:
	"""The working copy as a commit, as of now. jj snapshots on every command, so asking is enough."""
	return jj("log", "-r", "@", "--no-graph", "-T", "commit_id", cwd=repo).stdout.strip()


def restore(repo: pathlib.Path, before: str, paths: list[str]) -> None:
	"""Put exactly these paths back as they were in `before`, and nothing else in the working copy.

	By path rather than by operation: `jj op restore` would also take back whatever somebody
	edited elsewhere in the working copy while the update ran. A path is quoted as a literal file,
	so a bracket or a star in a name is not read as a pattern.
	"""
	literal = lambda path: 'root-file:"' + path.replace("\\", "\\\\").replace('"', '\\"') + '"'
	jj("restore", "--from", before, *map(literal, paths), cwd=repo)


def command_update(name: str | None, dry: bool = False, major: bool = False) -> int:
	"""Each repository's own `update`, kept only where that repository's own `verify` still passes.

	Moving is the repository's, because only it knows its resolvers, its pins and anything no
	resolver can move. Keeping is decided here, the same way for every repository and without
	knowing any of that: what the update changed is read from jj, and a verify that fails puts
	exactly those files back. A failed update is put back the same way, since it may have stopped
	halfway through a rewrite. The next `update` tries again from the top. See spec/toolchain.md,
	"Dependency policy".
	"""
	skipped, failed, reverted = [], [], []
	flags = (["--dry-run"] if dry else []) + (["--major"] if major else [])
	for repo in selected(name):
		if not declares(repo, "update"):
			skipped.append(label(repo))
			continue
		task = own_task(repo, "update")
		print(f"\n=== {' '.join([task, *flags])} ===")
		if dry:
			if subprocess.run(["mise", "run", task, *flags], cwd=ROOT).returncode != 0:
				failed.append(label(repo))
			continue
		before = snapshot(repo)
		code = subprocess.run(["mise", "run", task, *flags], cwd=ROOT).returncode
		after = snapshot(repo)
		paths = jj("diff", "--from", before, "--to", after, "--name-only", cwd=repo).stdout.splitlines()
		if code != 0:
			if paths:
				restore(repo, before, paths)
			failed.append(label(repo))
			continue
		if not paths:
			continue
		if not declares(repo, "verify"):
			print(f"\n{label(repo)} has no verify, so what moved is kept unchecked")
			continue
		check = own_task(repo, "verify")
		print(f"\n=== {check} ===")
		result = step(ROOT, "mise", "run", check)
		if result.returncode != 0:
			restore(repo, before, paths)
			reverted.append((label(repo), symptom(result.stdout), paths))

	summary("update", skipped, failed)
	if reverted:
		print("\nReverted, because verify failed with what moved; these files are back as they were:\n")
		for place, lines, paths in reverted:
			print(f"  {place}: {', '.join(paths)}")
			for line in lines:
				print(f"      {line}")
		print("\n  the full log is above; the next `update` tries the same bounds again")
	return 1 if failed or reverted else 0


def shadowing(project: pathlib.Path) -> list[str]:
	"""Files in a project that this repository already provides by position.

	Only version-controlled ones: `jj file list` is the question worth asking, because a copy
	nobody committed is a local accident and a committed one is what a fresh clone gets. An
	identical copy and a divergent one are both reported, differently -- the first is dead weight,
	the second is the shadowing this arrangement exists to avoid, and only a rule written down in
	spec/ can make it correct.

	Vendored source is skipped, on the rule that already excludes it from the linter and the
	formatter -- see spec/vendor.md. Svelte ships two runtime-legacy test samples that carry an
	`.editorconfig` of their own, and those are fixtures whose whole point is a local override:
	reading them as this repository being shadowed failed `verify` over files nobody here may edit.
	"""
	listed = jj("file", "list", cwd=project, check=False)
	found = []
	for relative in listed.stdout.splitlines():
		path = project / relative
		if path.name not in INHERITED or not path.is_file():
			continue
		if "vendor" in pathlib.PurePosixPath(relative).parts:
			continue
		provided = ROOT / path.name
		if provided.is_file() and provided.read_bytes() == path.read_bytes():
			found.append(f"{relative} is a byte-identical copy of the workspace's; delete it")
		elif extends_workspace(path, provided):
			continue
		else:
			found.append(f"{relative} shadows the workspace's, which is inherited by position")
	return found


def extends_workspace(path: pathlib.Path, provided: pathlib.Path) -> bool:
	"""Whether a project's `.oxlintrc.json` is a difference over the workspace's, not a copy.

	oxlint reads the nearest configuration per file and honors `extends`, so a file that names the
	workspace's there and carries only what differs is the tool's own way of stating a project's
	rule, and repeats nothing it could drift from. Read by pattern rather than parsed: the file
	carries comments, which no JSON parser here takes, and the question is one string. Only this
	name has such a mechanism. See spec/architecture/repos.md, "A copy is forbidden; a difference
	that says what it extends is not".
	"""
	if path.name != ".oxlintrc.json":
		return False
	text = path.read_text()
	named = re.search(r'"extends"\s*:\s*\[\s*"([^"]+)"', text)
	if named is None:
		return False
	return (path.parent / named.group(1)).resolve() == provided.resolve()


def command_publish(name: str | None, passed: list[str]) -> int:
	"""One repository's own `publish`, by its namespaced task path.

	**The only verb here that refuses to mean every repository.** Everywhere else a missing name
	is a convenience; here it would be a release of everything that has a publish task, to a
	registry that accepts a version once and where yanking leaves it downloadable. So the name is
	required, the workspace is not a candidate, and a project without the task is told so rather
	than quietly doing nothing.
	"""
	if not name:
		# The ones that actually have the task, not merely the ones that exist: an error that
		# suggests a command which then fails is worse than the error it replaced.
		without = "<name>"
		have = [
			d
			for d in registry()
			if (REPOS / d / "mise.toml").is_file()
			and "[tasks.publish]" in (REPOS / d / "mise.toml").read_text()
		]
		named = ", ".join(have) if have else without
		raise fail(f"publish takes a repository name, one of: {named}")
	repo = selected(name)[0]
	if repo == ROOT:
		raise fail("the workspace publishes nothing; it holds configuration")
	config = repo / "mise.toml"
	if not config.is_file() or "[tasks.publish]" not in config.read_text():
		raise fail(f"repos/{repo.name} has no publish task")
	task = f"//repos/{repo.name}:publish"
	# Whatever was typed after the name goes to the project's own task, unread.
	#
	# Every other verb here means one thing everywhere and owns `--dry-run`. Publishing does not:
	# what it is dry about, and which way round the flag runs, is the project's. press's mirror is
	# dry by default and takes `--live`; this used to forward `--dry-run` and nothing else, so
	# `publish press --live` ran a dry mirror and reported success -- the documented way to publish
	# could not publish. See spec/architecture/repos.md.
	print(f"=== {task}{' ' + ' '.join(passed) if passed else ''} ===")
	return subprocess.run(["mise", "run", task, *passed], cwd=ROOT).returncode


def command_check() -> int:
	problems = 0
	listed = registry()
	roots = set(task_roots())

	# One set, two files: mise cannot read repos.toml, so config_roots states it again.
	expected = {f"repos/{directory}" for directory in listed}
	for missing in sorted(expected - roots):
		print(f"mise.toml [monorepo].config_roots is missing {missing}")
		problems += 1
	for extra in sorted(roots - expected):
		print(f"mise.toml [monorepo].config_roots names {extra}, which {REGISTRY.name} does not list")
		problems += 1

	if REPOS.is_dir():
		for path in sorted(p for p in REPOS.iterdir() if p.is_dir()):
			if path.name not in listed:
				print(f"repos/{path.name} is on disk but not listed in {REGISTRY.name}")
				problems += 1
			elif not is_repository(path):
				print(f"repos/{path.name} is not a repository -- repos/*/ is ignored, so nothing tracks it")
				problems += 1
			else:
				for complaint in shadowing(path):
					print(f"repos/{path.name}/{complaint}")
					problems += 1

	if problems == 0:
		print(f"{len(listed)} listed, task roots agree")
	return 1 if problems else 0


def main(argv: list[str]) -> int:
	"""`<action> [name] [--dry-run]`, the flag anywhere -- it arrives last through mise.

	`publish` is the exception: its flags belong to the project being published, so anything this
	does not recognise is collected rather than refused, and handed on unread.
	"""
	dry = False
	major = False
	rest = []
	unknown = []
	for argument in argv:
		if argument in ("-n", "--dry-run"):
			dry = True
		elif argument == "--major":
			major = True
		elif argument.startswith("-"):
			unknown.append(argument)
		else:
			rest.append(argument)
	action = rest[0] if rest else None
	name = rest[1] if len(rest) > 1 else None
	# A name means that repository and nothing else, so whatever the verb would not act on is
	# refused rather than dropped: `check rdm lattice` checking rdm alone, or a mistyped flag doing
	# nothing, reads as done. publish hands what follows the name to the project, unread.
	if action == "publish":
		tail, skipped = [], 0
		for argument in argv:
			if skipped < 2 and not argument.startswith("-"):
				skipped += 1
				continue
			tail.append("--dry-run" if argument == "-n" else argument)
		return command_publish(name, tail)
	if unknown:
		raise fail(f"unknown option {unknown[0]}")
	if len(rest) > 2:
		raise fail(f"one name at most; {' '.join(rest[2:])} would have been ignored")
	if name and action in ("list", "check"):
		raise fail(f"{action} reads the whole registry and takes no name")
	if major and action != "update":
		raise fail("--major belongs to update; crossing a boundary is that command's decision to take")
	if action == "update":
		return command_update(name, dry, major)
	if action in ("fmt", "clean", "verify"):
		return command_dispatch(action, name, dry)
	if action == "list":
		return command_list()
	if action == "clone":
		return command_clone(name, dry)
	if action == "pull":
		return command_pull(name, dry)
	if action == "push":
		return command_push(name, dry)
	if action == "check":
		# Reads and reports; there is nothing for a dry run to hold back.
		return command_check()
	raise fail(
		"usage: repos list | clone | pull | push | fmt | update | clean | verify | publish | check"
		"  [name] [--dry-run]"
	)


if __name__ == "__main__":
	try:
		raise SystemExit(main(sys.argv[1:]))
	except subprocess.CalledProcessError as error:
		raise SystemExit(f"error: {' '.join(error.cmd)} failed") from error
