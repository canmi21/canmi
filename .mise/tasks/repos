#!/usr/bin/env python3
#MISE description="The repositories: `repos list|clone|pull|push|fmt|deps|clean|verify [name]`"
"""Every command here takes an optional repository name and means all of them without one.

The name is a key from repos.toml, which is the local directory: `repos pull press` is press,
`repos pull` is everything. The top-level `pull`, `push`, `check` and `fmt` tasks are one-line
aliases onto this, so the short form is what gets typed and this file is where it lives once.

  list             what the registry holds and what is on disk
  clone            clone whatever is listed and missing
  pull             fetch, and say what moved
  push             push main
  fmt              format the working copy through `jj fix`
  deps             update dependencies inside their ranges, and name what waits across one
  clean            remove build output and tool caches, never dependencies or local state
  verify           run each repository's own verify
  publish          run one repository's own publish; a name is required
  check            the registry, the task roots and the directories still agree

Every command that changes something takes `--dry-run` (`-n`) and reports what it would do
instead. `push` and `clone` have a real one; `fmt` gets there by running and rolling back.

push is the user's to run. An agent does not run it and does not offer to -- see
spec/commits.md.
"""

from __future__ import annotations

import json
import os
import pathlib
import re
import subprocess
import sys

sys.dont_write_bytecode = True
sys.stdout.reconfigure(line_buffering=True)

ROOT = pathlib.Path(__file__).resolve().parents[2]
REPOS = ROOT / "repos"
REGISTRY = ROOT / "repos.toml"
CONFIG = ROOT / "mise.toml"

# `directory = "user:repo"` inside the [repos] table. Read by pattern rather than with a TOML
# parser: this is one flat table, and which parser is available depends on the python mise
# happens to resolve, which is not a dependency worth taking for a line of this shape.
# Configuration this repository provides and every project below resolves by walking up. A
# project carrying its own copy is what `check` looks for: an identical one is dead weight, and
# a different one shadows this repository's silently. `.editorconfig` is the sharp case -- it
# carries `root = true`, whose whole meaning is to stop that walk -- and rustfmt likewise stops
# at the first file it finds. See spec/architecture/repos.md.
#
# `.gitattributes` is deliberately absent: git resolves attributes only within one worktree, so
# it never inherits and a project setting its own is correct.
INHERITED = (
	".editorconfig",
	"rustfmt.toml",
	"rust-toolchain.toml",
	".oxlintrc.json",
	".oxfmtrc.json",
	"jj.toml",
)

ENTRY = re.compile(r'^\s*([\w.-]+)\s*=\s*"([A-Za-z0-9][\w.-]*):([\w.-]+)"\s*$', re.MULTILINE)

# Directories a build tool writes and can write again, by the name it writes them under. This
# list decides what `clean` *looks at*; whether a match is actually removed is decided by version
# control, in `disposable`. Both halves are needed and neither is enough: press ignores `build/`
# and also tracks records under `data/build/`, so a name alone would delete them, while "anything
# git ignores" is `node_modules`, `.env`, press's photograph library and a local D1 database.
#
# Kept to names the toolchain writes rather than names a project chose. A cache belongs to the
# tool that produces it, and the tools are the workspace's to declare -- see spec/toolchain.md.
# `target` is absent on purpose: it is cargo's, `[build] target-dir` can move it anywhere, and a
# sweep matching the word would both miss the real one and find somebody else's.
SWEPT = ("dist", "build", "coverage", ".svelte-kit", ".turbo", ".output", "__pycache__")

# Caches that sit inside a directory whose other contents must not be touched, so the sweep looks
# for these by exact position and never descends past the parent.
#
# `node_modules` is the whole point of the distinction: clearing a cache must not turn into
# reinstalling dependencies, so the installed tree is left exactly as it is and only what tools
# dropped inside it goes. `.wrangler/state` is a local D1, KV and R2 emulation -- data somebody
# entered, not output somebody built -- and only `.wrangler/tmp` is a cache.
NESTED = {
	"node_modules": (
		".vite",
		".vite-temp",
		".cache",
		".vitest",
		".svelte2tsx-language-server-files",
	),
	".wrangler": ("tmp",),
}


def fail(message: str) -> "SystemExit":
	return SystemExit(f"error: {message}")


def registry() -> dict[str, tuple[str, str]]:
	"""directory -> (user, repo), in the order the file gives them."""
	if not REGISTRY.is_file():
		raise fail(f"{REGISTRY.name} does not exist")
	table = re.search(r"^\[repos\]\n((?:.*\n)*)", REGISTRY.read_text(), re.MULTILINE)
	found = {}
	for directory, user, repo in ENTRY.findall(table.group(1) if table else ""):
		if directory in found:
			raise fail(f"{REGISTRY.name} lists {directory} twice")
		found[directory] = (user, repo)
	return found


def selected(name: str | None) -> list[pathlib.Path]:
	"""The repositories a command applies to: one when named, all of them otherwise.

	**This workspace is one of them.** It has a remote, a working copy and files to format like
	any project, and leaving it out meant `push` reporting nothing to push while this very
	repository was a commit ahead. `workspace` is the name for it, matching what the tools task
	already accepted.
	"""
	listed = registry()
	if name == "workspace":
		return [ROOT]
	if name:
		if name not in listed:
			known = ", ".join(["workspace", *listed])
			raise fail(f"{REGISTRY.name} does not list {name}; the names are {known}")
		target = REPOS / name
		if not target.is_dir():
			raise fail(f"repos/{name} is listed but not cloned -- `mise run repos clone` first")
		return [target]
	return [ROOT] + [REPOS / d for d in listed if (REPOS / d).is_dir()]


def label(where: pathlib.Path) -> str:
	return "workspace" if where == ROOT else where.name


def is_repository(path: pathlib.Path) -> bool:
	return (path / ".git").exists() or (path / ".jj").exists()


def jj(*args: str, cwd: pathlib.Path, check: bool = True) -> subprocess.CompletedProcess:
	result = subprocess.run(["jj", *args], cwd=cwd, capture_output=True, text=True)
	if check and result.returncode != 0:
		sys.stderr.write(result.stderr)
		raise fail(f"jj {' '.join(args)} failed in {cwd.name}")
	return result


def task_roots() -> list[str]:
	block = re.search(r"^config_roots\s*=\s*\[(.*?)\]", CONFIG.read_text(), re.MULTILINE | re.DOTALL)
	return re.findall(r'"([^"]+)"', block.group(1)) if block else []


def command_list() -> int:
	listed = registry()
	on_disk = {p.name for p in REPOS.iterdir() if p.is_dir()} if REPOS.is_dir() else set()
	for directory, (user, repo) in listed.items():
		mark = "" if directory in on_disk else "   (not cloned)"
		print(f"{directory:<12} {user}:{repo}{mark}")
	for name in sorted(on_disk - set(listed)):
		print(f"{name:<12} on disk but not listed in {REGISTRY.name}")
	return 0


def command_clone(name: str | None, dry: bool = False) -> int:
	REPOS.mkdir(exist_ok=True)
	listed = registry()
	wanted = {name: listed[name]} if name and name in listed else listed
	added = 0
	for directory, (user, repo) in wanted.items():
		target = REPOS / directory
		if target.exists():
			continue
		if dry:
			print(f"would clone {user}:{repo} into repos/{directory}")
			added += 1
			continue
		print(f"cloning {user}:{repo} into repos/{directory}")
		# Colocated, because the git side is what the remote and any contributor speak.
		subprocess.run(
			["jj", "git", "clone", "--colocate", f"https://github.com/{user}/{repo}.git", str(target)],
			check=True,
		)
		added += 1
	print(f"{added} {'would be cloned' if dry else 'cloned'}")
	return 0


def command_pull(name: str | None, dry: bool = False) -> int:
	"""Fetch, and say what that brought in.

	`jj git fetch` has no dry run and needs none of its own: it writes remote-tracking refs and
	nothing else -- no commit, no working copy. The dry run skips it anyway and reports the
	divergence the last fetch left, saying which it is rather than passing stale state off as
	current.
	"""
	for repo in selected(name):
		if not is_repository(repo):
			print(f"{label(repo)}: not a repository, skipped")
			continue
		if not dry:
			result = jj("git", "fetch", cwd=repo, check=False)
			if result.returncode != 0:
				print(f"{label(repo)}: fetch failed")
				sys.stderr.write(result.stderr)
				continue
		behind = jj(
			"log", "--no-graph", "-r", "main..main@origin",
			"-T", 'commit_id.short() ++ " " ++ description.first_line() ++ "\\n"',
			cwd=repo, check=False,
		).stdout.strip()
		stale = " (as of the last fetch; none run)" if dry else ""
		print(f"{label(repo)}: {'up to date' if not behind else 'behind by'}{stale}")
		for line in behind.splitlines():
			print(f"    {line}")
	return 0


def command_push(name: str | None, dry: bool = False) -> int:
	for repo in selected(name):
		if not is_repository(repo):
			continue
		ahead = jj(
			"log", "--no-graph", "-r", "main@origin..main",
			"-T", 'commit_id.short() ++ "\\n"', cwd=repo, check=False,
		).stdout.strip()
		if not ahead:
			print(f"{label(repo)}: nothing to push")
			continue
		verb = "would push" if dry else "pushing"
		print(f"{label(repo)}: {verb} {len(ahead.splitlines())} commit(s)")
		command = ["jj", "git", "push", "--bookmark", "main"] + (["--dry-run"] if dry else [])
		subprocess.run(command, cwd=repo, check=True)
	return 0


def command_fmt(name: str | None, dry: bool = False) -> int:
	"""`jj fix` over the working copy, with the formatters jj.toml names for every repository.

	`jj fix` has no dry run, so the dry one runs it and then puts the repository back. That is
	cheaper than it sounds and better than the alternative: the operation log records every state
	the repository has been in, `jj op restore` returns it to the one from before, and what gets
	reported is therefore what the formatters actually did rather than a guess at it. Predicting
	the output of a formatter means reimplementing the formatter.
	"""
	for repo in selected(name):
		if not is_repository(repo):
			continue
		mark = jj("op", "log", "-n1", "--no-graph", "-T", "id.short()", cwd=repo).stdout.strip()
		before = jj("log", "-r", "@", "--no-graph", "-T", "commit_id", cwd=repo).stdout.strip()
		result = jj("fix", "--source", "@", cwd=repo, check=False)
		if result.returncode != 0:
			print(f"{label(repo)}: fix failed")
			sys.stderr.write(result.stderr)
			continue
		after = jj("log", "-r", "@", "--no-graph", "-T", "commit_id", cwd=repo).stdout.strip()
		if before == after:
			print(f"{label(repo)}: nothing to fix")
			continue
		changed = jj("diff", "--from", before, "--to", after, "--summary", cwd=repo, check=False)
		print(f"{label(repo)}: {'would reformat' if dry else 'reformatted'}")
		for line in changed.stdout.strip().splitlines():
			print(f"    {line}")
		if dry:
			jj("op", "restore", mark, cwd=repo)
	return 0


def command_verify(name: str | None, dry: bool = False) -> int:
	"""Each repository's own verify, by its namespaced task path."""
	failed = []
	for repo in selected(name):
		task = "//:verify" if repo == ROOT else f"//repos/{repo.name}:verify"
		if dry:
			print(f"would run {task}")
			continue
		print(f"\n=== {task} ===")
		if subprocess.run(["mise", "run", task], cwd=ROOT).returncode != 0:
			failed.append(label(repo))
	if failed:
		print(f"\nfailed: {', '.join(failed)}")
	return 1 if failed else 0


def manifests(where: pathlib.Path) -> list[str]:
	"""Which resolvers own dependencies in this repository, in the order they should be asked.

	cargo first: press and seam declare both, and the Rust half is what the JavaScript half builds
	against there rather than the other way round.
	"""
	found = []
	if (where / "Cargo.toml").is_file():
		found.append("cargo")
	if (where / "package.json").is_file():
		found.append("pnpm")
	return found


def recursive(where: pathlib.Path) -> list[str]:
	"""`-r`, but only where there is a pnpm workspace for it to mean something, and never vendored.

	Without a `pnpm-workspace.yaml` pnpm reads `-r` as "walk down from here", and here is a
	directory with five other repositories under it: asked from the workspace root it descended
	into `repos/press/apps/api` and failed on a lockfile that is press's business, not this one's.

	The vendor filter is the rule in spec/vendor.md, which this command broke on its first real
	run. seam lists `vendor/*` as workspace packages, so `pnpm update -r` rewrote eleven ranges in
	`vendor/kit/package.json` -- source that is kept as upstream wrote it precisely so the next
	upgrade stays a copy rather than a hand merge. A vendored package is upgraded by taking a newer
	upstream, never by a resolver here.
	"""
	if not (where / "pnpm-workspace.yaml").is_file():
		return []
	return ["-r", "--filter", "!./vendor/**"]


# pnpm's name for "this version exists and is younger than minimumReleaseAge". press sets that
# delay to a day, so a Cloudflare release from this morning stops the run -- which is the policy
# working, not the command failing. See spec/toolchain.md on the dependency policy.
IMMATURE = "ERR_PNPM_NO_MATURE_MATCHING_VERSION"


def step(where: pathlib.Path, *command: str, quiet: bool = False) -> subprocess.CompletedProcess:
	"""One resolver command, its output shown as it arrives and kept, unless only the text is asked.

	Shown as it arrives rather than captured and printed at the end, because a cargo update that
	resolves a large graph is long enough that silence reads as a hang. Kept as well as shown,
	because what a resolver refused for has to be read back: a run that stops on the supply-chain
	delay is a wait and a run that stops on anything else is a failure, and the difference is a
	line of its output.
	"""
	if quiet:
		return subprocess.run(list(command), cwd=where, capture_output=True, text=True)
	print(f"$ {' '.join(command)}")
	process = subprocess.Popen(
		list(command), cwd=where, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True
	)
	seen = []
	for line in process.stdout:
		print(line, end="")
		seen.append(line)
	return subprocess.CompletedProcess(command, process.wait(), "".join(seen), "")


def upgrade_available() -> bool:
	"""Whether `cargo upgrade` exists. It is cargo-edit, which cargo does not ship.

	mise's registry does not carry cargo-edit, and the only backend that could is `cargo:`, which
	builds it from source -- a compile on every fresh machine to answer a question asked at most
	weekly. So it is a tool this repository uses when it is there and names when it is not, rather
	than one it declares. Only the major half needs it; `cargo update` is cargo's own.
	"""
	return subprocess.run(["cargo", "upgrade", "--version"], capture_output=True).returncode == 0


def command_deps(name: str | None, dry: bool = False, major: bool = False) -> int:
	"""Dependencies within the ranges their manifests declare, and what waits across one.

	The same shape as the toolchain half and for the same reason. `cargo update` and `pnpm update`
	move inside the range a manifest asks for; crossing one rewrites the manifest, which is a
	decision with a diff behind it exactly as crossing a tool pin is. So the default moves inside
	and reports the rest, and `--major` is what takes it.

	**What waits is measured, not predicted.** Each resolver is asked what is still out of date
	*after* the in-range update has run, because whatever survives that is across a range boundary
	by construction. The alternative is reimplementing two resolvers' range arithmetic in order to
	disagree with them later.
	"""
	edit = upgrade_available()
	# A resolver that refuses is not a resolver that had nothing to do, and the first version of
	# this could not tell them apart: press's `pnpm update --latest` stopped on the supply-chain
	# delay -- eight versions younger than `minimumReleaseAge` -- and the run went on to report
	# that dependencies had been moved across their ranges. Nothing had moved. A step that fails
	# is named here and the command exits non-zero.
	failed = []
	immature = []

	def take(repo: pathlib.Path, *command: str) -> None:
		result = step(repo, *command)
		if result.returncode == 0:
			return
		# A refusal on the supply-chain delay is press's own policy holding, and it lifts itself
		# within the day. Reporting it as a failed run would make `update` red on any morning
		# Cloudflare shipped, which teaches a person to stop reading the last line.
		if IMMATURE in result.stdout:
			immature.append(label(repo))
		else:
			failed.append((label(repo), " ".join(command)))

	for repo in selected(name):
		kinds = manifests(repo)
		if not kinds:
			continue
		print(f"\n=== {label(repo)} ===")
		if "cargo" in kinds:
			if major and edit:
				take(repo, "cargo", "upgrade", "--incompatible", *(["--dry-run"] if dry else []))
			take(repo, "cargo", "update", *(["--dry-run"] if dry else []))
		if "pnpm" in kinds:
			if dry:
				# pnpm update has no dry run, so the read-only question stands in for it. Its exit
				# code says whether anything is outdated rather than whether it worked, so unlike
				# the others it is not checked.
				step(repo, "pnpm", "outdated", *recursive(repo))
			else:
				take(repo, "pnpm", "update", *recursive(repo), *(["--latest"] if major else []))

	print("\n" + "-" * 72)
	if immature:
		print(f"Held by the supply-chain delay, nothing moved: {', '.join(sorted(set(immature)))}")
		print("  a version younger than minimumReleaseAge; run again once it has aged\n")
	if failed:
		print("Refused, and nothing moved in these:\n")
		for place, command in failed:
			print(f"  {place:<12} {command}")
		print("\n  the resolver said why above; this reports it rather than passing over it")
		return 1
	if major:
		print("Dependencies were moved across their ranges. Run verify before trusting this.\n")
		return 0
	print("Beyond the ranges each manifest declares:\n")
	if not edit:
		print("  cargo upgrade is missing, so no crate's major was checked")
		print("  `cargo install cargo-edit` is what supplies it")
	held = False
	for repo in selected(name):
		kinds = manifests(repo)
		lines = []
		if "cargo" in kinds and edit:
			result = step(repo, "cargo", "upgrade", "--incompatible", "--dry-run", quiet=True)
			lines += [line for line in result.stdout.splitlines() if line.strip()]
		if "pnpm" in kinds:
			result = step(repo, "pnpm", "outdated", *recursive(repo), quiet=True)
			lines += [line for line in result.stdout.splitlines() if line.strip()]
		if lines:
			held = True
			print(f"{label(repo)}:")
			for line in lines:
				print(f"    {line}")
	if not held:
		print("  nothing; every dependency is at the top of the range its manifest allows")
	else:
		print("\n  `mise run repos deps --major` rewrites the manifests; nothing else here does")
	return 0


def disposable(repo: pathlib.Path, path: pathlib.Path) -> bool:
	"""Whether the repository's own version control says this path is output rather than record.

	Two questions, because either alone deletes something somebody wanted. The path has to be
	ignored -- a `dist/` that is committed is a decision, not an oversight -- and nothing tracked
	may live under it. press is where both earn their place: `data/build/` holds five records the
	site's build reads and cannot regenerate without a Rust toolchain, sitting inside a directory
	whose name is on the sweep list, under a `data/**` ignore with the records named back in.

	git rather than jj: `check-ignore` and `ls-files` answer exactly these two questions, every
	repository here is colocated, and the ignore file they read is the one the project wrote.
	"""
	relative = str(path.relative_to(repo))
	if subprocess.run(["git", "check-ignore", "-q", relative], cwd=repo).returncode != 0:
		return False
	tracked = subprocess.run(
		["git", "ls-files", "--", relative], cwd=repo, capture_output=True, text=True
	)
	return not tracked.stdout.strip()


def cargo_output(repo: pathlib.Path) -> pathlib.Path | None:
	"""Where cargo writes, asked rather than guessed.

	Asked because `[build] target-dir` moves it and because guessing was wrong in both directions
	at once. The sweep list leaves `target` out on the grounds that cargo owns it -- and then the
	walk went straight through it and matched every `target/debug/build` inside, reporting a
	gigabyte of cargo's own output as though this command had found it. Pruning what cargo names
	is the same rule the list was written for, applied where it actually decides something.
	"""
	result = subprocess.run(
		["cargo", "metadata", "--format-version", "1", "--no-deps"],
		cwd=repo,
		capture_output=True,
		text=True,
	)
	if result.returncode != 0:
		return None
	try:
		return pathlib.Path(json.loads(result.stdout)["target_directory"])
	except (ValueError, KeyError):
		return None


def artifacts(repo: pathlib.Path) -> list[pathlib.Path]:
	"""Every candidate under one repository, stopping at each boundary that is not its own.

	**A nested repository is not part of this one.** The workspace holds five of them under
	`repos/`, so a sweep that walked through would make `clean workspace` mean `clean`, and press
	lists `repos/*` among its pnpm workspace packages, so the same is true one level down. The walk
	stops at anything carrying a `.git` or a `.jj` of its own.
	"""
	found = []
	output = cargo_output(repo) if (repo / "Cargo.toml").is_file() else None
	for current, directories, files in os.walk(repo):
		here = pathlib.Path(current)
		keep = []
		for name in directories:
			path = here / name
			if name in (".git", ".jj") or is_repository(path):
				continue
			if output is not None and path == output:
				continue
			if name in NESTED:
				found.extend(path / cache for cache in NESTED[name] if (path / cache).exists())
				continue
			if name in SWEPT:
				found.append(path)
				continue
			keep.append(name)
		# Pruned in place, which is what os.walk reads back to decide where it goes next. A match
		# is not descended into either: what is inside something already being removed is not a
		# second finding.
		directories[:] = keep
		found.extend(here / name for name in files if name.endswith(".tsbuildinfo"))
	return [path for path in found if disposable(repo, path)]


def weight(path: pathlib.Path) -> int:
	"""Bytes under a path, counting a symlink as the link rather than as what it points at.

	node_modules is a forest of links into pnpm's store, so following them would report a cache as
	several gigabytes and report the same gigabytes again for the next repository.
	"""
	if path.is_file() or path.is_symlink():
		return path.lstat().st_size
	total = 0
	for current, _, files in os.walk(path):
		for name in files:
			try:
				total += (pathlib.Path(current) / name).lstat().st_size
			except OSError:
				continue
	return total


def size(count: float) -> str:
	for unit in ("B", "KiB", "MiB", "GiB"):
		if count < 1024 or unit == "GiB":
			return f"{count:.0f} {unit}" if unit == "B" else f"{count:.1f} {unit}"
		count /= 1024
	return f"{count:.1f} GiB"


def command_clean(name: str | None, dry: bool = False) -> int:
	"""Build output and tool caches, and nothing a person would have to make again.

	The line this draws is what makes it safe to run without thinking: **a cache is what a tool
	wrote and can write again, from what is already on disk.** Dependencies are not caches --
	`node_modules` and `Cargo.lock`'s downloads stay, and only what tools dropped inside them goes,
	because a clean that ends in a reinstall is not a clean, it is a network bill. Local state is
	not a cache either: `.wrangler/state` is a database somebody typed into.

	pnpm's own store is pruned, but only on the run that names no repository. It is one store for
	the whole machine, so pruning it from inside one project would be reaching a long way outside
	what was asked for. It removes packages nothing references and never touches an installed tree.
	"""
	total = 0
	for repo in selected(name):
		print(f"\n=== {label(repo)} ===")
		if (repo / "Cargo.toml").is_file():
			# cargo's own, because the target directory is cargo's to name and a `[build]
			# target-dir` anywhere up the chain moves it somewhere this sweep would never look.
			result = step(repo, "cargo", "clean", *(["--dry-run"] if dry else []), quiet=True)
			for line in (result.stdout + result.stderr).splitlines():
				if line.strip():
					print(f"    {line.strip()}")
		for path in sorted(artifacts(repo)):
			bytes_here = weight(path)
			total += bytes_here
			print(f"    {str(path.relative_to(repo)):<52} {size(bytes_here):>10}")
			if not dry:
				subprocess.run(["rm", "-rf", str(path)], check=True)

	if name is None:
		print("\n=== pnpm store ===")
		if dry:
			# No dry run of its own, and the honest stand-in for one is a sentence. Reporting a
			# figure by running it would be the opposite of what the flag promises.
			print("    would prune packages the store holds that nothing installed references")
		else:
			step(ROOT, "pnpm", "store", "prune")

	print("\n" + "-" * 72)
	# Two numbers rather than one sum. cargo reports its own removal per repository and reports it
	# in its own units, and adding a parsed figure to a measured one would produce a total that is
	# right only until cargo rewords the line.
	verb = "would be freed" if dry else "freed"
	swept = f"{size(total)} {verb} by the sweep" if total else "the sweep found nothing to free"
	print(f"{swept}; cargo's own totals are the per-repository lines above")
	print("  dependencies were not touched; a clean that ends in a reinstall is not a clean")
	return 0


def shadowing(project: pathlib.Path) -> list[str]:
	"""Files in a project that this repository already provides by position.

	Only version-controlled ones: `jj file list` is the question worth asking, because a copy
	nobody committed is a local accident and a committed one is what a fresh clone gets. An
	identical copy and a divergent one are both reported, differently -- the first is dead weight,
	the second is the shadowing this arrangement exists to avoid, and only a rule written down in
	spec/ can make it correct.

	Vendored source is skipped, on the rule that already excludes it from the linter and the
	formatter -- see spec/vendor.md. Svelte ships two runtime-legacy test samples that carry an
	`.editorconfig` of their own, and those are fixtures whose whole point is a local override:
	reading them as this repository being shadowed failed `verify` over files nobody here may edit.
	"""
	listed = jj("file", "list", cwd=project, check=False)
	found = []
	for relative in listed.stdout.splitlines():
		path = project / relative
		if path.name not in INHERITED or not path.is_file():
			continue
		if "vendor" in pathlib.PurePosixPath(relative).parts:
			continue
		provided = ROOT / path.name
		if provided.is_file() and provided.read_bytes() == path.read_bytes():
			found.append(f"{relative} is a byte-identical copy of the workspace's; delete it")
		else:
			found.append(f"{relative} shadows the workspace's, which is inherited by position")
	return found


def command_publish(name: str | None, dry: bool = False) -> int:
	"""One repository's own `publish`, by its namespaced task path.

	**The only verb here that refuses to mean every repository.** Everywhere else a missing name
	is a convenience; here it would be a release of everything that has a publish task, to a
	registry that accepts a version once and where yanking leaves it downloadable. So the name is
	required, the workspace is not a candidate, and a project without the task is told so rather
	than quietly doing nothing.
	"""
	if not name:
		# The ones that actually have the task, not merely the ones that exist: an error that
		# suggests a command which then fails is worse than the error it replaced.
		without = "<name>"
		have = [
			d
			for d in registry()
			if (REPOS / d / "mise.toml").is_file()
			and "[tasks.publish]" in (REPOS / d / "mise.toml").read_text()
		]
		named = ", ".join(have) if have else without
		raise fail(f"publish takes a repository name, one of: {named}")
	repo = selected(name)[0]
	if repo == ROOT:
		raise fail("the workspace publishes nothing; it holds configuration")
	config = repo / "mise.toml"
	if not config.is_file() or "[tasks.publish]" not in config.read_text():
		raise fail(f"repos/{repo.name} has no publish task")
	task = f"//repos/{repo.name}:publish"
	print(f"=== {task}{' --dry-run' if dry else ''} ===")
	command = ["mise", "run", task] + (["--dry-run"] if dry else [])
	return subprocess.run(command, cwd=ROOT).returncode


def command_check() -> int:
	problems = 0
	listed = registry()
	roots = set(task_roots())

	# One set, two files: mise cannot read repos.toml, so config_roots states it again.
	expected = {f"repos/{directory}" for directory in listed}
	for missing in sorted(expected - roots):
		print(f"mise.toml [monorepo].config_roots is missing {missing}")
		problems += 1
	for extra in sorted(roots - expected):
		print(f"mise.toml [monorepo].config_roots names {extra}, which {REGISTRY.name} does not list")
		problems += 1

	if REPOS.is_dir():
		for path in sorted(p for p in REPOS.iterdir() if p.is_dir()):
			if path.name not in listed:
				print(f"repos/{path.name} is on disk but not listed in {REGISTRY.name}")
				problems += 1
			elif not is_repository(path):
				print(f"repos/{path.name} is not a repository -- repos/*/ is ignored, so nothing tracks it")
				problems += 1
			else:
				for complaint in shadowing(path):
					print(f"repos/{path.name}/{complaint}")
					problems += 1

	if problems == 0:
		print(f"{len(listed)} listed, task roots agree")
	return 1 if problems else 0


def main(argv: list[str]) -> int:
	"""`<action> [name] [--dry-run]`, the flag anywhere -- it arrives last through mise."""
	dry = False
	major = False
	rest = []
	for argument in argv:
		if argument in ("-n", "--dry-run"):
			dry = True
		elif argument == "--major":
			major = True
		elif argument.startswith("-"):
			raise fail(f"unknown option {argument}")
		else:
			rest.append(argument)
	action = rest[0] if rest else None
	name = rest[1] if len(rest) > 1 else None
	if major and action != "deps":
		raise fail("--major belongs to deps; crossing a boundary is that command's decision to take")
	if action == "deps":
		return command_deps(name, dry, major)
	if action == "clean":
		return command_clean(name, dry)
	if action == "list":
		return command_list()
	if action == "clone":
		return command_clone(name, dry)
	if action == "pull":
		return command_pull(name, dry)
	if action == "push":
		return command_push(name, dry)
	if action == "fmt":
		return command_fmt(name, dry)
	if action == "verify":
		return command_verify(name, dry)
	if action == "publish":
		return command_publish(name, dry)
	if action == "check":
		# Reads and reports; there is nothing for a dry run to hold back.
		return command_check()
	raise fail(
		"usage: repos list | clone | pull | push | fmt | deps | clean | verify | publish | check"
		"  [name] [--dry-run]"
	)


if __name__ == "__main__":
	try:
		raise SystemExit(main(sys.argv[1:]))
	except subprocess.CalledProcessError as error:
		raise SystemExit(f"error: {' '.join(error.cmd)} failed") from error
