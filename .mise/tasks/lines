#!/usr/bin/env python3
#MISE description="Hold every file of ours under the line limits: `lines [root ...]`"
"""A file of ours is under five hundred lines, and one over a thousand fails the gate.

Given no root, checks this repository and every project cloned under `repos/`; given roots,
checks those. Every file version control keeps is measured, prose and data included, less what
is not ours to shorten: a binary, a lockfile or anything as common, whatever a project's
`.gitattributes` marks generated or vendored, and any directory named `vendor` or after it. See
spec/code.md, "A file is read whole, so it stays short".

The soft limit is a warning tier, so it is advice until `AUDIT` is set, when it fails the way
every other warning does under `mise run audit`. The hard limit fails always, except for a file
its project defers by `lines=deferred` in `.gitattributes`, which is reported and passed.
"""

from __future__ import annotations

import fnmatch
import os
import pathlib
import subprocess
import sys

SOFT = 500
HARD = 1000

# Machine output common enough to name here rather than in every project: lockfiles, minified
# bundles and source maps. What only one project generates is marked in that project's
# `.gitattributes` instead.
COMMON = ("*.lock", "*.lockb", "pnpm-lock.yaml", "package-lock.json", "*.min.js", "*.min.css", "*.map")

# What git reads as binary: a NUL in the first eight thousand bytes.
SNIFF = 8000

# Only for a root with no version control to ask, where untracked output is still on disk.
SKIPPED = {"node_modules", "target", "dist", "build", ".git", ".jj", ".svelte-kit", ".wrangler"}

# The attributes read: the two GitHub's statistics read as well, so one list serves both, and the
# deferral, which says the file is known to be over and a split is owed.
ATTRIBUTES = ("linguist-generated", "linguist-vendored", "lines")


def tracked(root: pathlib.Path) -> list[str] | None:
	"""The files version control keeps under `root`, relative to it, or None with none to ask.

	jj first, because a jj workspace such as the sandbox has no `.git` of its own.
	"""
	for command in (["jj", "file", "list"], ["git", "ls-files"]):
		if command[0] == "jj" and not (root / ".jj").exists():
			continue
		try:
			result = subprocess.run(command, cwd=root, capture_output=True, text=True)
		except OSError:
			continue
		if result.returncode == 0:
			return [line for line in result.stdout.splitlines() if line]
	return None


def walked(root: pathlib.Path, workspace: bool) -> list[str]:
	"""Every file under `root`, for a root no version control describes."""
	found = []
	for directory, names, files in os.walk(root):
		here = pathlib.Path(directory)
		names[:] = [one for one in names if one not in SKIPPED and not (workspace and here == root and one == "repos")]
		found.extend(str((here / name).relative_to(root)) for name in files)
	return found


def attributes(root: pathlib.Path, paths: list[str]) -> dict[str, dict[str, str]]:
	"""Each path's attributes of `ATTRIBUTES` that are set, as git reads `.gitattributes`.

	Asked of git where there is one; otherwise the root's own `.gitattributes` is read, which is
	the only one any project here keeps.
	"""
	found: dict[str, dict[str, str]] = {}
	if (root / ".git").exists():
		result = subprocess.run(
			["git", "check-attr", "--stdin", *ATTRIBUTES],
			cwd=root,
			input="\n".join(paths),
			capture_output=True,
			text=True,
		)
		if result.returncode == 0:
			for line in result.stdout.splitlines():
				path, name, value = line.rsplit(": ", 2)
				if value not in ("unspecified", "unset"):
					found.setdefault(path, {})[name] = value
			return found
	rules = []
	source = root / ".gitattributes"
	for line in source.read_text().splitlines() if source.is_file() else []:
		fields = line.split()
		if not fields or fields[0].startswith("#"):
			continue
		pattern, settings = fields[0], fields[1:]
		values = {}
		for setting in settings:
			name, _, value = setting.partition("=")
			values[name] = value or "set"
		rules.append((pattern, values))
	for path in paths:
		for pattern, values in rules:
			subject = path if "/" in pattern else path.rsplit("/", 1)[-1]
			if fnmatch.fnmatch(subject, pattern.lstrip("/")):
				for name in ATTRIBUTES:
					if name in values:
						found.setdefault(path, {})[name] = values[name]
	return found


def measured(root: pathlib.Path, workspace: bool) -> tuple[list[tuple[str, int]], set[str]]:
	"""Every file of ours under `root` with its line count, and the ones it defers."""
	paths = tracked(root)
	if paths is None:
		paths = walked(root, workspace)
	if workspace:
		# `repos/` under the workspace is every project's own checkout, measured as its own root.
		paths = [path for path in paths if not path.startswith("repos/")]
	paths = [
		path
		for path in paths
		if not any(part.startswith("vendor") for part in path.split("/")[:-1])
		and not any(fnmatch.fnmatch(path.rsplit("/", 1)[-1], one) for one in COMMON)
	]
	marks = attributes(root, paths)
	found = []
	deferred = set()
	for path in paths:
		mark = marks.get(path, {})
		if mark.get("linguist-generated") == "true" or mark.get("linguist-vendored") == "true":
			continue
		try:
			data = (root / path).read_bytes()
		except OSError:
			continue
		if b"\0" in data[:SNIFF]:
			continue
		if mark.get("lines") == "deferred":
			deferred.add(path)
		found.append((path, len(data.splitlines())))
	return found, deferred


def main(argv: list[str]) -> int:
	here = pathlib.Path(__file__).resolve().parents[2]
	roots = [pathlib.Path(one).resolve() for one in argv] or [
		here,
		*(one for one in (here / "repos").iterdir() if one.is_dir()),
	]
	strict = os.environ.get("AUDIT") is not None
	over_hard: list[tuple[str, int]] = []
	over_soft: list[tuple[str, int]] = []
	postponed: list[tuple[str, int]] = []
	stale: list[str] = []
	total = 0
	for root in roots:
		found, deferred = measured(root, root == here)
		for path, count in found:
			total += 1
			shown = os.path.relpath(root / path, here)
			if path in deferred:
				(postponed if count > HARD else stale).append((shown, count) if count > HARD else shown)
			elif count > HARD:
				over_hard.append((shown, count))
			elif count > SOFT:
				over_soft.append((shown, count))
	for path, count in sorted(over_soft, key=lambda one: -one[1]):
		print(f"warning: {path} is {count} lines, over the soft limit of {SOFT}")
	for path, count in sorted(postponed, key=lambda one: -one[1]):
		print(f"warning: {path} is {count} lines, over the hard limit of {HARD}, deferred")
	for path in sorted(stale):
		print(f"warning: {path} is under the hard limit; its `lines=deferred` can go")
	for path, count in sorted(over_hard, key=lambda one: -one[1]):
		print(f"error: {path} is {count} lines, over the hard limit of {HARD}")
	warned = bool(over_soft) or bool(postponed) or bool(stale)
	failed = bool(over_hard) or (strict and warned)
	print(
		f"lines: {total} files measured, {len(over_soft)} over {SOFT}, {len(over_hard)} over {HARD}, "
		f"{len(postponed)} deferred" + (" (audit: warnings fail)" if strict else "")
	)
	return 1 if failed else 0


if __name__ == "__main__":
	sys.exit(main(sys.argv[1:]))
