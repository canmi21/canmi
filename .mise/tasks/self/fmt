#!/bin/sh
#MISE description="The workspace's own fmt: oxfmt and the ReScript formatter over the files jj.toml gives them"
#MISE hide=true
#USAGE flag "-n --dry-run" help="List the files that would change and write nothing"
# The same files as jj.toml's entries, so `fmt` and the formatting a commit gets agree.
set -e
cd "$MISE_PROJECT_ROOT"
files='**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx,css,json,jsonc,md,svelte}'
if [ "${usage_dry_run:-}" = true ]; then
	oxfmt --list-different --no-error-on-unmatched-pattern "$files" || true
	rescript format --check || true
else
	oxfmt --no-error-on-unmatched-pattern "$files"
	rescript format
fi
