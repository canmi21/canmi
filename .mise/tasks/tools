#!/usr/bin/env python3
#MISE description="The toolchain across every repository: `tools check`, `tools outdated`, `tools up`"
"""Keep the pinned toolchain current, and honest about which channel it is on.

The version a tool runs at here has to be the version an outside build resolves. Cloudflare
reads `.node-version` and `packageManager`; it has never heard of mise. So those files and the
mise pins are one fact in several places, and they are checked against each other.

  check      offline: the files an outside build reads agree with what mise resolves
  outdated   online: what is behind its publisher's stable channel, and what waits across a pin
  up         upgrade within the pins, then name the majors it would not cross

`up` also runs `rustup update`. rust is the one tool `mise upgrade` cannot move -- mise's rust is
a symlink to rustup's toolchain rather than an install of its own -- so without it the channel
was reported as behind on every run with no command here that would have advanced it.

**Stable means the publisher's stable channel, not the highest version that exists.** mise
resolves a pin against every published release, which for pnpm includes the `next` line -- `11`
resolved to 11.25.0 while npm's `latest` was 11.24.0. Being ahead of stable is as wrong here as
being behind it, and both are reported.

**A pin makes "current" two questions, and only one of them used to be asked.** "Is a new major
out" is answered by the publisher's newest release; "am I current on the line I pinned" is
answered by that line's own stable release, `latest-11` rather than `latest`. Asking only the
first is how `pnpm = "11.24"` sat two stable releases behind its own line while every run here
reported the single thing waiting as 12, across a pin, and therefore not `up`'s to take. Both are
asked now, and a pin narrower than its line is named as the reason a release is out of reach.

`check` is part of `mise run verify` and needs no network. `outdated` and `up` do. `up` takes
`--dry-run` (`-n`) and reports what it would install and rewrite.
"""

from __future__ import annotations

import http.client
import json
import pathlib
import re
import subprocess
import sys
import urllib.error
import urllib.request

sys.dont_write_bytecode = True
sys.stdout.reconfigure(line_buffering=True)

ROOT = pathlib.Path(__file__).resolve().parents[2]
REPOS = ROOT / "repos"

# Where a tool's stable channel is published, and how to read it. A tool absent from here has
# no channel this can check; `outdated` says so rather than guessing from the highest tag.
# What mise would take if the pins were lifted. mise resolves against every published version
# and has never heard of a dist-tag, so this is where its answer and the publisher's stable
# channel come apart -- and where its own advice has to be dropped rather than passed on.
BUMP = re.compile(r"^Would install (\S+)@(\S+)\s*$", re.MULTILINE)
OWNER = re.compile(r"^Would bump (\S+)@\S+ in (.+?)\s*$", re.MULTILINE)

CHANNELS = {
	"pnpm": ("npm", "pnpm"),
	"oxlint": ("npm", "oxlint"),
	"jj": ("github", "jj-vcs/jj"),
	"rclone": ("github", "rclone/rclone"),
	"watchexec": ("github", "watchexec/watchexec"),
	"node": ("node", ""),
	"rust": ("rust", ""),
}

# One answer per (tool, line) for the life of the process. `up` asks the same questions from every
# repository it walks and the rust manifest alone is a megabyte, so without this a six-repository
# run fetched it six times to be told the same thing.
ASKED: dict[tuple[str, str | None], str | None] = {}


def fail(message: str) -> "SystemExit":
	return SystemExit(f"error: {message}")


def get(url: str) -> dict | list:
	request = urllib.request.Request(url, headers={"User-Agent": "workspace-tools"})
	with urllib.request.urlopen(request, timeout=20) as response:
		return json.load(response)


def stable(tool: str, line: str | None = None) -> str | None:
	"""What an outside build would resolve as this tool's current release.

	`line` names a series -- "12" for pnpm, "0.45" for jj -- and asking for one is a different
	question: not "is there a new major" but "am I current on the line I pinned". Only the second
	notices a pin that has fallen behind its own line, and this file was blind to it. `pnpm =
	"11.24"` sat two stable releases behind `latest-11` while every report here compared it against
	`latest` and said the only thing waiting was 12, which is across a pin and therefore not
	something `up` would take. The result was a workspace that was behind, on a line it had chosen,
	and told nobody.

	A line whose channel cannot be read is None rather than the highest version in it. A published
	release is not a released one -- that is the whole subject of this file.
	"""
	if (tool, line) in ASKED:
		return ASKED[(tool, line)]
	answer = ask(tool, line)
	ASKED[(tool, line)] = answer
	return answer


def ask(tool: str, line: str | None) -> str | None:
	kind, where = CHANNELS.get(tool, (None, None))
	try:
		if kind == "npm":
			tags = get(f"https://registry.npmjs.org/{where}")["dist-tags"]
			if line is None:
				return tags["latest"]
			# npm's per-line tag where the publisher keeps one. pnpm does, for every major it still
			# supports. Where there is none, the overall `latest` answers for its own line and for
			# no other -- an older line without a tag has no stable release this can name.
			if f"latest-{line}" in tags:
				return tags[f"latest-{line}"]
			return tags["latest"] if series(tags["latest"]) == line else None
		if kind == "github":
			if line is None:
				release = get(f"https://api.github.com/repos/{where}/releases/latest")
				# The `latest` endpoint already excludes prereleases; the flag is checked anyway
				# because a repository can move a release into that state after publishing it.
				return None if release.get("prerelease") else release["tag_name"].lstrip("v")
			# No endpoint answers "the latest release of 0.45", so the release list is walked. It
			# arrives newest first, and a draft or a prerelease is not a release.
			for release in get(f"https://api.github.com/repos/{where}/releases?per_page=100"):
				if release.get("prerelease") or release.get("draft"):
					continue
				tag = release["tag_name"].lstrip("v")
				if series(tag) == line:
					return tag
			return None
		if kind == "node":
			for release in get("https://nodejs.org/dist/index.json"):
				version = release["version"].lstrip("v")
				if line is None or series(version) == line:
					return version
			return None
		if kind == "rust":
			# The whole channel manifest, because the version wanted is inside [pkg.rust] and the
			# first one in the file is cargo's. It is about a megabyte; this runs online only.
			request = urllib.request.Request(
				"https://static.rust-lang.org/dist/channel-rust-stable.toml",
				headers={"User-Agent": "workspace-tools"},
			)
			with urllib.request.urlopen(request, timeout=30) as response:
				body = response.read().decode("utf8", "replace")
			found = re.search(r'^\[pkg\.rust\]\nversion = "(\d+\.\d+\.\d+)', body, re.MULTILINE)
			return found.group(1) if found else None
	except (
		urllib.error.URLError,
		http.client.HTTPException,
		OSError,
		ValueError,
		KeyError,
		IndexError,
	):
		# A channel that cannot be read is None, and every caller already says so rather than
		# guessing. That includes a read that starts and stops halfway: npm's document for pnpm is
		# three quarters of a megabyte and an `IncompleteRead` on it took down a whole `update`
		# run, mid-install, over a question none of the installing depended on.
		return None
	return None


def order(version: str) -> tuple:
	"""A version as something comparable. Numeric where it can be, so 10 sorts above 9.

	The first version of this compared `tuple(version.split("."))`, which is string comparison:
	"10" sorts below "9" and the ahead/behind verdict inverts at every tenth release. Nothing had
	hit it yet, which is the only reason it survived being written.
	"""
	return tuple(int(part) if part.isdigit() else part for part in version.split("."))


def series(version: str) -> str | None:
	"""The part of a version a pin is meant to hold.

	The major, except below 1.0 where the minor is the breaking release -- jj at 0.44 and 0.45
	are as far apart as node 26 and 27. A channel like `stable` has no series.
	"""
	parts = version.split(".")
	if not parts[0].isdigit():
		return None
	if parts[0] != "0":
		return parts[0]
	return ".".join(parts[:2]) if len(parts) > 1 and parts[1].isdigit() else None


def configured(name: str | None = None) -> list[pathlib.Path]:
	"""Directories declaring tools of their own: one when named, the workspace first otherwise.

	`workspace` names this repository, so a single tool can be upgraded without touching the
	projects; any other name is a directory under repos/.
	"""
	if name == "workspace":
		return [ROOT]
	if name:
		target = REPOS / name
		if not (target / "mise.toml").is_file():
			raise fail(f"repos/{name} declares no tools of its own")
		return [target]
	found = [ROOT]
	if REPOS.is_dir():
		found.extend(sorted(p for p in REPOS.iterdir() if (p / "mise.toml").is_file()))
	return found


def label(where: pathlib.Path) -> str:
	return "workspace" if where == ROOT else f"repos/{where.name}"


def installed(where: pathlib.Path) -> list[tuple[str, str]]:
	"""(tool, version) for the tools this directory's own mise.toml declares."""
	result = subprocess.run(
		["mise", "ls", "--current", "--json"], cwd=where, capture_output=True, text=True
	)
	if result.returncode != 0:
		return []
	own = str((where / "mise.toml").resolve())
	found = []
	for tool, entries in json.loads(result.stdout).items():
		for entry in entries:
			if entry.get("source", {}).get("path") == own:
				found.append((tool, entry.get("version", "")))
	return sorted(found)


def pinned(where: pathlib.Path) -> dict[str, str]:
	"""tool -> the string `[tools]` actually asks for, which is not always the whole series.

	`pnpm = "11"` and `pnpm = "11.24"` name the same line and are not the same pin: only the first
	lets `up` move inside it. Without this the report said 11.26.0 was available inside the pin
	while nothing in this repository would ever have taken it, which is a worse answer than the
	silence it replaced -- it names an upgrade and implies a command that does it.
	"""
	result = subprocess.run(
		["mise", "ls", "--current", "--json"], cwd=where, capture_output=True, text=True
	)
	if result.returncode != 0:
		return {}
	own = str((where / "mise.toml").resolve())
	found = {}
	for tool, entries in json.loads(result.stdout).items():
		for entry in entries:
			if entry.get("source", {}).get("path") == own:
				found[tool] = entry.get("requested_version", "")
	return found


def allows(pin: str, version: str) -> bool:
	"""Whether a pin would accept this version. mise matches a pin as a prefix of the version."""
	return bool(pin) and (version == pin or version.startswith(f"{pin}."))


def active(where: pathlib.Path, tool: str) -> str | None:
	"""What `tool` resolves to in this directory, inherited or not."""
	result = subprocess.run(
		["mise", "ls", "--current", "--json"], cwd=where, capture_output=True, text=True
	)
	if result.returncode != 0:
		return None
	for entry in json.loads(result.stdout).get(tool, []):
		return entry.get("version")
	return None


def rust_channel(where: pathlib.Path) -> str | None:
	"""What rustup's stable toolchain currently is, with rust-toolchain.toml stepped around.

	`rustc --version` would answer with the version that file pins, which is comparing the file
	against itself: it could never drift and the check could never fail. `rustup run stable` asks
	the channel instead, which is the thing the file is supposed to be a record of.

	mise is not asked because its rust is a symlink to the rustup toolchain rather than one it
	installs, so it has no version of its own to report.
	"""
	result = subprocess.run(
		["rustup", "run", "stable", "rustc", "--version"], cwd=where, capture_output=True, text=True
	)
	if result.returncode != 0:
		return None
	found = re.search(r"rustc (\d+\.\d+\.\d+)", result.stdout)
	return found.group(1) if found else None


def derived(where: pathlib.Path) -> list[tuple[pathlib.Path, str, str]]:
	"""(file, written, resolved) for the files an outside build reads, where they disagree.

	These restate a version whose home is a mise.toml. They exist because Cloudflare and every
	other outside build reads them and has never heard of mise, so they are written from that
	pin rather than maintained -- `up` rewrites them, `check` fails when something else moved
	one. Same shape as any other generated mirror here.
	"""
	found = []

	node_version = where / ".node-version"
	if node_version.is_file():
		running = active(where, "node")
		written = node_version.read_text().strip()
		if running and written != running:
			found.append((node_version, written, running))

	toolchain = where / "rust-toolchain.toml"
	if toolchain.is_file():
		running = rust_channel(where)
		written = re.search(r'channel\s*=\s*"([^"]+)"', toolchain.read_text())
		if running and written and written.group(1) != running:
			found.append((toolchain, written.group(1), running))

	manifest = where / "package.json"
	if manifest.is_file():
		declared = json.loads(manifest.read_text()).get("packageManager", "")
		if declared.startswith("pnpm@"):
			running = active(where, "pnpm")
			written = declared.removeprefix("pnpm@")
			if running and written != running:
				found.append((manifest, written, running))
	return found


def write_derived(path: pathlib.Path, resolved: str) -> None:
	if path.name == ".node-version":
		path.write_text(f"{resolved}\n")
		return
	if path.name == "rust-toolchain.toml":
		text = path.read_text()
		path.write_text(re.sub(r'(channel\s*=\s*")[^"]+(")', rf"\g<1>{resolved}\g<2>", text, count=1))
		return
	text = path.read_text()
	start = text.index('"packageManager"')
	end = text.index("\n", start)
	line = text[start:end]
	path.write_text(text[:start] + re.sub(r"pnpm@[^\"]+", f"pnpm@{resolved}", line) + text[end:])


def redundant(where: pathlib.Path, provided: dict[str, str]) -> list[str]:
	"""Tools a project declares that the workspace already declares.

	mise resolves the nearest declaration, so a project restating one takes over the version for
	that directory -- silently while the two agree, and invisibly once they stop. A project states
	a tool of its own only where it needs one the workspace does not carry, the way press names
	rclone. See spec/architecture/repos.md.
	"""
	found = []
	for tool, version in installed(where):
		if tool not in provided:
			continue
		if provided[tool] == version:
			found.append(f"declares {tool} = {version}, which the workspace already declares; drop it")
		else:
			found.append(f"pins {tool} to {version} over the workspace's {provided[tool]}")
	return found


def command_check(name: str | None = None) -> int:
	"""The files an outside build reads must name the version mise resolves."""
	# Two kinds, counted apart because only one of them has a command that fixes it. Printing
	# "`mise run update` rewrites them" under a redundant declaration would be advice that does
	# not work: update installs and regenerates, and never edits a [tools] table.
	drifted = shadowed = 0
	provided = dict(installed(ROOT))
	for where in configured(name):
		for path, written, resolved in derived(where):
			print(f"{label(where)}: {path.name} says {written}, mise resolves {resolved}")
			drifted += 1
		if where != ROOT:
			for complaint in redundant(where, provided):
				print(f"{label(where)} {complaint}")
				shadowed += 1
	if drifted:
		print("    an outside build reads these; nothing out there has heard of mise")
		print("    `mise run update` rewrites them")
	if shadowed:
		print("    a project declares a tool only where the workspace does not carry one")
		print("    edit the project's [tools]; nothing rewrites it for you")
	if not drifted and not shadowed:
		print("the versions an outside build reads agree with mise")
	return 1 if drifted or shadowed else 0


def resolved(where: pathlib.Path, tool: str, version: str) -> str | None:
	"""The concrete release behind a pin that names a channel instead of a version.

	`rust = "stable"` is the only one here. A channel name has no series, so every comparison that
	starts by splitting it on dots gets a wrong answer -- which is how `rust stable -> 1.98.1
	across a pin` came to be printed on every run: "stable" and "1.98.1" have different first
	components, so the code read a channel name as a major two behind. rust has no major to cross,
	says so in `mise.toml` and in the spec, and the report said otherwise anyway.

	What is actually worth asking is whether the toolchain the channel resolves to is the one the
	channel currently holds, and rustup is the only thing that can answer it -- mise's rust is a
	symlink to rustup's toolchain rather than one mise installs.
	"""
	return rust_channel(where) if tool == "rust" else None


def survey(name: str | None = None) -> list[tuple]:
	"""(where, tool, installed, the pin, its line's stable release, the publisher's newest).

	Two channels rather than one, because a pin makes them two different questions and reporting
	only the second hid the first. See `stable`.
	"""
	rows = []
	for where in configured(name):
		pins = pinned(where)
		for tool, version in installed(where):
			line = series(version)
			within = stable(tool, line) if line else None
			rows.append((where, tool, version, pins.get(tool, ""), within, stable(tool)))
	return rows


def report(rows) -> tuple[list[str], int, int, int]:
	"""One line per tool that is not where it should be, and nothing for the ones that are.

	Returned rather than printed, because `up` prints this section under a heading and must know
	whether there is anything under it before writing the heading.

	The order of these branches is the point. Ahead is tested before across-a-pin: a prerelease
	that has crossed a series boundary -- pnpm publishing 13.0.0 on `next` while npm's stable tag
	is still 12 -- differs in series from stable and is also ahead of it, and reading that as
	"behind, go and take it" is precisely the inversion this file exists to prevent.
	"""
	lines = []
	behind = ahead = unknown = 0
	for where, tool, version, pin, line, newest in rows:
		place = f"{label(where):<14} {tool:<10} {version:<12}"
		if newest is None:
			lines.append(f"{place} no stable channel to compare")
			unknown += 1
		elif series(version) is None:
			# A channel, not a version. Whether it is current is a question about the toolchain it
			# resolves to, and there is no pin involved either way.
			holds = resolved(where, tool, version)
			if holds and holds != newest:
				lines.append(f"{place} holds {holds}, the channel is {newest}")
				behind += 1
		elif line and order(version) > order(line):
			lines.append(f"{place} is AHEAD of stable {line}")
			ahead += 1
		elif line and version != line:
			# Behind inside its own line. Invisible until this file learned to ask for a line: the
			# comparison was against the publisher's newest, which for a pinned tool is nearly
			# always across a pin and therefore filed as something `up` was right not to take.
			# Whether `up` can reach it is a second question, and the pin is what answers it.
			within = "inside the pin" if allows(pin, line) else f'held back by the pin "{pin}"'
			lines.append(f"{place} -> {line} {within}")
			behind += 1
		elif series(version) != series(newest):
			lines.append(f"{place} -> {newest} across a pin")
			behind += 1
		elif version != newest:
			lines.append(f"{place} -> {newest}")
			behind += 1
	return lines, behind, ahead, unknown


def command_outdated(name: str | None = None) -> int:
	lines, behind, ahead, unknown = report(survey(name))
	for line in lines:
		print(line)
	if not behind and not ahead:
		# Counted apart from the rest: a tool with no readable channel is not a tool that is
		# current, and saying so under two lines that just said the opposite is how a summary stops
		# being read at all.
		verdict = "every tool this can ask about is on its publisher's stable release"
		print(verdict if unknown else "every tool is on its publisher's stable release")
	elif ahead:
		print("\nA version ahead of stable is on a prerelease line. Pin it down to the stable one.")
	return 0


def beyond(where: pathlib.Path) -> list[tuple[str, str, str, str | None]]:
	"""(tool, version, stable) for what `mise upgrade --bump` would take in this directory.

	Asked because mise's own line about it -- "Newer versions are available outside the configured
	version ranges, use `mise upgrade --bump`" -- is advice this repository must not follow. mise
	resolves against every published release and cannot see a dist-tag, so for pnpm that line
	points at the `next` line: it named 11.25.0 while npm's stable tag was 11.24.0. `up` drops the
	line and prints what is below instead, which says which channel the version is actually on.

	The line was not dropped for tidiness. It was read, believed, and acted on, and the pin was
	edited to a prerelease because this command said to.
	"""
	result = subprocess.run(
		["mise", "upgrade", "--bump", "--dry-run"], cwd=where, capture_output=True, text=True
	)
	# Keyed by the file that owns the pin, not by where the question was asked. A pin in this
	# repository is visible from every project below it, so asking in three directories returned
	# the same tool three times; the "Would bump ... in <file>" line is what tells them apart.
	owners = {tool: owner for tool, owner in OWNER.findall(result.stdout)}
	found = []
	for tool, version in BUMP.findall(result.stdout):
		owner = pathlib.Path(owners.get(tool, str(where / "mise.toml"))).expanduser()
		try:
			owner = owner.relative_to(ROOT)
		except ValueError:
			pass
		# Against its own line, not against the publisher's newest. A bump target is by definition
		# in a series nobody here has pinned, and "is 12.1.0 a real release" is a question only
		# `latest-12` answers -- comparing it against `latest` was how this reported 12.1.0 as
		# waiting when npm had no `latest-12` at all.
		found.append((str(owner), tool, version, stable(tool, series(version))))
	return found


def command_up(name: str | None = None, dry: bool = False) -> int:
	moved = []
	waiting = []

	# rust is the one tool `mise upgrade` cannot move. mise's rust is a symlink to rustup's
	# toolchain rather than an install of its own, so inside the `stable` channel it is rustup that
	# advances -- and nothing here was asking it to. The result was a tool reported as behind on
	# every run with no command in this repository that would have moved it, which is a report
	# nobody can act on. It runs once rather than per repository: rustup is global.
	if any(tool == "rust" for where in configured(name) for tool, _ in installed(where)):
		if dry:
			print("would run rustup update stable")
		elif subprocess.run(["rustup", "update", "stable"], cwd=ROOT).returncode != 0:
			print("rustup update failed; rust is left where it was")

	for where in configured(name):
		before = dict(installed(where))
		command = ["mise", "upgrade", "--local"] + (["--dry-run"] if dry else [])
		# Captured rather than streamed so the bump advice can be dropped. The cost is that a long
		# install prints nothing until it finishes, which is the smaller of the two problems.
		run = subprocess.run(command, cwd=where, capture_output=True, text=True)
		for stream in (run.stdout, run.stderr):
			for line in stream.splitlines():
				if "upgrade --bump" not in line:
					print(line)
		if run.returncode != 0:
			raise fail(f"mise upgrade failed in {label(where)}")
		for row in beyond(where):
			if row not in waiting:
				waiting.append(row)
		after = before if dry else dict(installed(where))
		for tool, was in before.items():
			if after.get(tool) != was:
				moved.append((label(where), tool, was, after.get(tool, "?")))

	# Written from the pins rather than maintained: whatever the toolchain moved to, the files
	# an outside build reads say so without anybody remembering to edit them.
	rewritten = []
	for where in configured(name):
		for path, _, current in derived(where):
			if not dry:
				write_derived(path, current)
			rewritten.append((label(where), path.name, current))

	print()
	if rewritten:
		for place, written, resolved in rewritten:
			verb = "would be rewritten to" if dry else "rewritten to"
			print(f"{place:<14} {written:<16} {verb} {resolved}")
	if moved:
		for place, tool, was, now in moved:
			print(f"{place:<14} {tool:<10} {was} -> {now}")
		print("\nRun each repository's verify before trusting this; a toolchain move is a change.")
	elif dry:
		print("nothing to install; mise reported no upgrade within the pins")
	else:
		print("everything is current within its pins")

	# In place of the line that was dropped. Same facts, plus the one mise does not have.
	if waiting:
		print("\nBeyond the pins, and what channel each is actually on:\n")
		for owner, tool, version, current in waiting:
			if current is None:
				verdict = "no stable channel to compare"
			elif order(version) > order(current):
				verdict = f"ahead of stable {current}; a prerelease line, do not take it"
			else:
				verdict = "stable; edit [tools] to cross the pin"
			print(f"{owner:<24} {tool:<10} {version:<12} {verdict}")

	# Last, after a separator: this is the part a person has to act on, and an install log is
	# long enough to bury it. What is worth printing is decided by `report` rather than by a filter
	# here, because the two disagreed -- a filter comparing against the publisher's newest kept
	# rows that only differ by a major, which is the one thing this section is not about.
	lines, _, _, _ = report(survey(name))
	if lines:
		print("\n" + "-" * 72)
		print("Against each publisher's stable channel:\n")
		for line in lines:
			print(line)
		print("\n  a pin is crossed by editing [tools]; nothing here does it for you")
	return 0


def main(argv: list[str]) -> int:
	"""`<action> [name] [--dry-run]`, the flag anywhere -- it arrives last through mise."""
	dry = False
	rest = []
	for argument in argv:
		if argument in ("-n", "--dry-run"):
			dry = True
		elif argument.startswith("-"):
			raise fail(f"unknown option {argument}")
		else:
			rest.append(argument)
	action = rest[0] if rest else None
	name = rest[1] if len(rest) > 1 else None
	# check and outdated read and report; there is nothing for a dry run to hold back.
	if action == "check":
		return command_check(name)
	if action == "outdated":
		return command_outdated(name)
	if action == "up":
		return command_up(name, dry)
	raise fail("usage: tools check | outdated | up  [name] [--dry-run]")


if __name__ == "__main__":
	try:
		raise SystemExit(main(sys.argv[1:]))
	except subprocess.CalledProcessError as error:
		raise SystemExit(f"error: {' '.join(error.cmd)} failed") from error
