#!/usr/bin/env python3
#MISE description="The toolchain across every repository: `tools check`, `tools outdated`, `tools up`"
"""Keep the pinned toolchain current, and honest about which channel it is on.

The version a tool runs at here has to be the version an outside build resolves. Cloudflare
reads `.node-version` and `packageManager`; it has never heard of mise. So those files and the
mise pins are one fact in several places, and they are checked against each other.

  check      offline: the files an outside build reads agree with what mise resolves
  outdated   online: what is behind its publisher's stable channel, and what waits across a pin
  up         upgrade within the pins, then name the majors it would not cross

**Stable means the publisher's stable channel, not the highest version that exists.** mise
resolves a pin against every published release, which for pnpm includes the `next` line -- `11`
resolved to 11.25.0 while npm's `latest` was 11.24.0. Being ahead of stable is as wrong here as
being behind it, and both are reported.

`check` is part of `mise run verify` and needs no network. `outdated` and `up` do. `up` takes
`--dry-run` (`-n`) and reports what it would install and rewrite.
"""

import json
import pathlib
import re
import subprocess
import sys
import urllib.error
import urllib.request

sys.dont_write_bytecode = True
sys.stdout.reconfigure(line_buffering=True)

ROOT = pathlib.Path(__file__).resolve().parents[2]
REPOS = ROOT / "repos"

# Where a tool's stable channel is published, and how to read it. A tool absent from here has
# no channel this can check; `outdated` says so rather than guessing from the highest tag.
# What mise would take if the pins were lifted. mise resolves against every published version
# and has never heard of a dist-tag, so this is where its answer and the publisher's stable
# channel come apart -- and where its own advice has to be dropped rather than passed on.
BUMP = re.compile(r"^Would install (\S+)@(\S+)\s*$", re.MULTILINE)
OWNER = re.compile(r"^Would bump (\S+)@\S+ in (.+?)\s*$", re.MULTILINE)

CHANNELS = {
	"pnpm": ("npm", "pnpm"),
	"oxlint": ("npm", "oxlint"),
	"jj": ("github", "jj-vcs/jj"),
	"rclone": ("github", "rclone/rclone"),
	"node": ("node", ""),
}


def fail(message: str) -> "SystemExit":
	return SystemExit(f"error: {message}")


def get(url: str) -> dict | list:
	request = urllib.request.Request(url, headers={"User-Agent": "workspace-tools"})
	with urllib.request.urlopen(request, timeout=20) as response:
		return json.load(response)


def stable(tool: str) -> str | None:
	"""What an outside build would resolve as this tool's current release."""
	kind, where = CHANNELS.get(tool, (None, None))
	try:
		if kind == "npm":
			return get(f"https://registry.npmjs.org/{where}")["dist-tags"]["latest"]
		if kind == "github":
			release = get(f"https://api.github.com/repos/{where}/releases/latest")
			# The `latest` endpoint already excludes prereleases; the flag is checked anyway
			# because a repository can move a release into that state after publishing it.
			return None if release.get("prerelease") else release["tag_name"].lstrip("v")
		if kind == "node":
			return get("https://nodejs.org/dist/index.json")[0]["version"].lstrip("v")
	except (urllib.error.URLError, KeyError, IndexError, TimeoutError):
		return None
	return None


def order(version: str) -> tuple:
	"""A version as something comparable. Numeric where it can be, so 10 sorts above 9.

	The first version of this compared `tuple(version.split("."))`, which is string comparison:
	"10" sorts below "9" and the ahead/behind verdict inverts at every tenth release. Nothing had
	hit it yet, which is the only reason it survived being written.
	"""
	return tuple(int(part) if part.isdigit() else part for part in version.split("."))


def series(version: str) -> str | None:
	"""The part of a version a pin is meant to hold.

	The major, except below 1.0 where the minor is the breaking release -- jj at 0.44 and 0.45
	are as far apart as node 26 and 27. A channel like `stable` has no series.
	"""
	parts = version.split(".")
	if not parts[0].isdigit():
		return None
	if parts[0] != "0":
		return parts[0]
	return ".".join(parts[:2]) if len(parts) > 1 and parts[1].isdigit() else None


def configured(name: str | None = None) -> list[pathlib.Path]:
	"""Directories declaring tools of their own: one when named, the workspace first otherwise.

	`workspace` names this repository, so a single tool can be upgraded without touching the
	projects; any other name is a directory under repos/.
	"""
	if name == "workspace":
		return [ROOT]
	if name:
		target = REPOS / name
		if not (target / "mise.toml").is_file():
			raise fail(f"repos/{name} declares no tools of its own")
		return [target]
	found = [ROOT]
	if REPOS.is_dir():
		found.extend(sorted(p for p in REPOS.iterdir() if (p / "mise.toml").is_file()))
	return found


def label(where: pathlib.Path) -> str:
	return "workspace" if where == ROOT else f"repos/{where.name}"


def installed(where: pathlib.Path) -> list[tuple[str, str]]:
	"""(tool, version) for the tools this directory's own mise.toml declares."""
	result = subprocess.run(
		["mise", "ls", "--current", "--json"], cwd=where, capture_output=True, text=True
	)
	if result.returncode != 0:
		return []
	own = str((where / "mise.toml").resolve())
	found = []
	for tool, entries in json.loads(result.stdout).items():
		for entry in entries:
			if entry.get("source", {}).get("path") == own:
				found.append((tool, entry.get("version", "")))
	return sorted(found)


def active(where: pathlib.Path, tool: str) -> str | None:
	"""What `tool` resolves to in this directory, inherited or not."""
	result = subprocess.run(
		["mise", "ls", "--current", "--json"], cwd=where, capture_output=True, text=True
	)
	if result.returncode != 0:
		return None
	for entry in json.loads(result.stdout).get(tool, []):
		return entry.get("version")
	return None


def derived(where: pathlib.Path) -> list[tuple[pathlib.Path, str, str]]:
	"""(file, written, resolved) for the files an outside build reads, where they disagree.

	These restate a version whose home is a mise.toml. They exist because Cloudflare and every
	other outside build reads them and has never heard of mise, so they are written from that
	pin rather than maintained -- `up` rewrites them, `check` fails when something else moved
	one. Same shape as any other generated mirror here.
	"""
	found = []

	node_version = where / ".node-version"
	if node_version.is_file():
		running = active(where, "node")
		written = node_version.read_text().strip()
		if running and written != running:
			found.append((node_version, written, running))

	manifest = where / "package.json"
	if manifest.is_file():
		declared = json.loads(manifest.read_text()).get("packageManager", "")
		if declared.startswith("pnpm@"):
			running = active(where, "pnpm")
			written = declared.removeprefix("pnpm@")
			if running and written != running:
				found.append((manifest, written, running))
	return found


def write_derived(path: pathlib.Path, resolved: str) -> None:
	if path.name == ".node-version":
		path.write_text(f"{resolved}\n")
		return
	text = path.read_text()
	start = text.index('"packageManager"')
	end = text.index("\n", start)
	line = text[start:end]
	path.write_text(text[:start] + re.sub(r"pnpm@[^\"]+", f"pnpm@{resolved}", line) + text[end:])


def redundant(where: pathlib.Path, provided: dict[str, str]) -> list[str]:
	"""Tools a project declares that the workspace already declares.

	mise resolves the nearest declaration, so a project restating one takes over the version for
	that directory -- silently while the two agree, and invisibly once they stop. A project states
	a tool of its own only where it needs one the workspace does not carry, the way press names
	rclone. See spec/architecture/repos.md.
	"""
	found = []
	for tool, version in installed(where):
		if tool not in provided:
			continue
		if provided[tool] == version:
			found.append(f"declares {tool} = {version}, which the workspace already declares; drop it")
		else:
			found.append(f"pins {tool} to {version} over the workspace's {provided[tool]}")
	return found


def command_check(name: str | None = None) -> int:
	"""The files an outside build reads must name the version mise resolves."""
	# Two kinds, counted apart because only one of them has a command that fixes it. Printing
	# "`mise run update` rewrites them" under a redundant declaration would be advice that does
	# not work: update installs and regenerates, and never edits a [tools] table.
	drifted = shadowed = 0
	provided = dict(installed(ROOT))
	for where in configured(name):
		for path, written, resolved in derived(where):
			print(f"{label(where)}: {path.name} says {written}, mise resolves {resolved}")
			drifted += 1
		if where != ROOT:
			for complaint in redundant(where, provided):
				print(f"{label(where)} {complaint}")
				shadowed += 1
	if drifted:
		print("    an outside build reads these; nothing out there has heard of mise")
		print("    `mise run update` rewrites them")
	if shadowed:
		print("    a project declares a tool only where the workspace does not carry one")
		print("    edit the project's [tools]; nothing rewrites it for you")
	if not drifted and not shadowed:
		print("the versions an outside build reads agree with mise")
	return 1 if drifted or shadowed else 0


def survey(name: str | None = None) -> list[tuple[pathlib.Path, str, str, str | None]]:
	"""(where, tool, installed, stable) for everything declared here."""
	rows = []
	for where in configured(name):
		for tool, version in installed(where):
			rows.append((where, tool, version, stable(tool)))
	return rows


def report(rows) -> tuple[int, int, int]:
	behind = ahead = unknown = 0
	for where, tool, version, current in rows:
		if current is None:
			print(f"{label(where):<14} {tool:<10} {version:<12} no stable channel to compare")
			unknown += 1
		elif version == current:
			continue
		elif series(version) != series(current):
			print(f"{label(where):<14} {tool:<10} {version:<12} -> {current} across a pin")
			behind += 1
		elif order(version) > order(current):
			print(f"{label(where):<14} {tool:<10} {version:<12} is AHEAD of stable {current}")
			ahead += 1
		else:
			print(f"{label(where):<14} {tool:<10} {version:<12} -> {current}")
			behind += 1
	return behind, ahead, unknown


def command_outdated(name: str | None = None) -> int:
	behind, ahead, _ = report(survey(name))
	if not behind and not ahead:
		print("every tool is on its publisher's stable release")
	elif ahead:
		print("\nA version ahead of stable is on a prerelease line. Pin it down to the stable one.")
	return 0


def beyond(where: pathlib.Path) -> list[tuple[str, str, str, str | None]]:
	"""(tool, version, stable) for what `mise upgrade --bump` would take in this directory.

	Asked because mise's own line about it -- "Newer versions are available outside the configured
	version ranges, use `mise upgrade --bump`" -- is advice this repository must not follow. mise
	resolves against every published release and cannot see a dist-tag, so for pnpm that line
	points at the `next` line: it named 11.25.0 while npm's stable tag was 11.24.0. `up` drops the
	line and prints what is below instead, which says which channel the version is actually on.

	The line was not dropped for tidiness. It was read, believed, and acted on, and the pin was
	edited to a prerelease because this command said to.
	"""
	result = subprocess.run(
		["mise", "upgrade", "--bump", "--dry-run"], cwd=where, capture_output=True, text=True
	)
	# Keyed by the file that owns the pin, not by where the question was asked. A pin in this
	# repository is visible from every project below it, so asking in three directories returned
	# the same tool three times; the "Would bump ... in <file>" line is what tells them apart.
	owners = {tool: owner for tool, owner in OWNER.findall(result.stdout)}
	found = []
	for tool, version in BUMP.findall(result.stdout):
		owner = pathlib.Path(owners.get(tool, str(where / "mise.toml"))).expanduser()
		try:
			owner = owner.relative_to(ROOT)
		except ValueError:
			pass
		found.append((str(owner), tool, version, stable(tool)))
	return found


def command_up(name: str | None = None, dry: bool = False) -> int:
	moved = []
	waiting = []
	for where in configured(name):
		before = dict(installed(where))
		command = ["mise", "upgrade", "--local"] + (["--dry-run"] if dry else [])
		# Captured rather than streamed so the bump advice can be dropped. The cost is that a long
		# install prints nothing until it finishes, which is the smaller of the two problems.
		run = subprocess.run(command, cwd=where, capture_output=True, text=True)
		for stream in (run.stdout, run.stderr):
			for line in stream.splitlines():
				if "upgrade --bump" not in line:
					print(line)
		if run.returncode != 0:
			raise fail(f"mise upgrade failed in {label(where)}")
		for row in beyond(where):
			if row not in waiting:
				waiting.append(row)
		after = before if dry else dict(installed(where))
		for tool, was in before.items():
			if after.get(tool) != was:
				moved.append((label(where), tool, was, after.get(tool, "?")))

	# Written from the pins rather than maintained: whatever the toolchain moved to, the files
	# an outside build reads say so without anybody remembering to edit them.
	rewritten = []
	for where in configured(name):
		for path, _, resolved in derived(where):
			if not dry:
				write_derived(path, resolved)
			rewritten.append((label(where), path.name, resolved))

	print()
	if rewritten:
		for place, written, resolved in rewritten:
			verb = "would be rewritten to" if dry else "rewritten to"
			print(f"{place:<14} {written:<16} {verb} {resolved}")
	if moved:
		for place, tool, was, now in moved:
			print(f"{place:<14} {tool:<10} {was} -> {now}")
		print("\nRun each repository's verify before trusting this; a toolchain move is a change.")
	elif dry:
		print("nothing to install; mise reported no upgrade within the pins")
	else:
		print("everything is current within its pins")

	# In place of the line that was dropped. Same facts, plus the one mise does not have.
	if waiting:
		print("\nBeyond the pins, and what channel each is actually on:\n")
		for owner, tool, version, current in waiting:
			if current is None:
				verdict = "no stable channel to compare"
			elif order(version) > order(current):
				verdict = f"ahead of stable {current}; a prerelease line, do not take it"
			else:
				verdict = "stable; edit [tools] to cross the pin"
			print(f"{owner:<24} {tool:<10} {version:<12} {verdict}")

	# Last, after a separator: this is the part a person has to act on, and an install log is
	# long enough to bury it.
	rows = [r for r in survey(name) if r[3] is not None and r[2] != r[3]]
	if rows:
		print("\n" + "-" * 72)
		print("Against each publisher's stable channel:\n")
		report(rows)
		print("\n  a pin is crossed by editing [tools]; nothing here does it for you")
	return 0


def main(argv: list[str]) -> int:
	"""`<action> [name] [--dry-run]`, the flag anywhere -- it arrives last through mise."""
	dry = False
	rest = []
	for argument in argv:
		if argument in ("-n", "--dry-run"):
			dry = True
		elif argument.startswith("-"):
			raise fail(f"unknown option {argument}")
		else:
			rest.append(argument)
	action = rest[0] if rest else None
	name = rest[1] if len(rest) > 1 else None
	# check and outdated read and report; there is nothing for a dry run to hold back.
	if action == "check":
		return command_check(name)
	if action == "outdated":
		return command_outdated(name)
	if action == "up":
		return command_up(name, dry)
	raise fail("usage: tools check | outdated | up  [name] [--dry-run]")


if __name__ == "__main__":
	try:
		raise SystemExit(main(sys.argv[1:]))
	except subprocess.CalledProcessError as error:
		raise SystemExit(f"error: {' '.join(error.cmd)} failed") from error
