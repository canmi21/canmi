#!/usr/bin/env python3
#MISE description="The toolchain across every repository: `tools check`, `tools outdated`, `tools up`"
"""Keep the pinned toolchain current, and honest about which channel it is on.

The version a tool runs at here has to be the version an outside build resolves. Cloudflare
reads `.node-version` and `packageManager`; it has never heard of mise. So those files and the
mise pins are one fact in several places, and they are checked against each other.

  check      offline: the files an outside build reads agree with what mise resolves
  outdated   online: what is behind its publisher's stable channel, and what waits across a pin
  up         upgrade within the pins, then name the majors it would not cross

**Stable means the publisher's stable channel, not the highest version that exists.** mise
resolves a pin against every published release, which for pnpm includes the `next` line -- `11`
resolved to 11.25.0 while npm's `latest` was 11.24.0. Being ahead of stable is as wrong here as
being behind it, and both are reported.

`check` is part of `mise run verify` and needs no network. `outdated` and `up` do.
"""

import json
import pathlib
import re
import subprocess
import sys
import urllib.error
import urllib.request

sys.dont_write_bytecode = True
sys.stdout.reconfigure(line_buffering=True)

ROOT = pathlib.Path(__file__).resolve().parents[2]
REPOS = ROOT / "repos"

# Where a tool's stable channel is published, and how to read it. A tool absent from here has
# no channel this can check; `outdated` says so rather than guessing from the highest tag.
CHANNELS = {
	"pnpm": ("npm", "pnpm"),
	"oxlint": ("npm", "oxlint"),
	"jj": ("github", "jj-vcs/jj"),
	"rclone": ("github", "rclone/rclone"),
	"node": ("node", ""),
}


def fail(message: str) -> "SystemExit":
	return SystemExit(f"error: {message}")


def get(url: str) -> dict | list:
	request = urllib.request.Request(url, headers={"User-Agent": "workspace-tools"})
	with urllib.request.urlopen(request, timeout=20) as response:
		return json.load(response)


def stable(tool: str) -> str | None:
	"""What an outside build would resolve as this tool's current release."""
	kind, where = CHANNELS.get(tool, (None, None))
	try:
		if kind == "npm":
			return get(f"https://registry.npmjs.org/{where}")["dist-tags"]["latest"]
		if kind == "github":
			release = get(f"https://api.github.com/repos/{where}/releases/latest")
			# The `latest` endpoint already excludes prereleases; the flag is checked anyway
			# because a repository can move a release into that state after publishing it.
			return None if release.get("prerelease") else release["tag_name"].lstrip("v")
		if kind == "node":
			return get("https://nodejs.org/dist/index.json")[0]["version"].lstrip("v")
	except (urllib.error.URLError, KeyError, IndexError, TimeoutError):
		return None
	return None


def series(version: str) -> str | None:
	"""The part of a version a pin is meant to hold.

	The major, except below 1.0 where the minor is the breaking release -- jj at 0.44 and 0.45
	are as far apart as node 26 and 27. A channel like `stable` has no series.
	"""
	parts = version.split(".")
	if not parts[0].isdigit():
		return None
	if parts[0] != "0":
		return parts[0]
	return ".".join(parts[:2]) if len(parts) > 1 and parts[1].isdigit() else None


def configured() -> list[pathlib.Path]:
	"""Every directory here that declares tools of its own, the workspace first."""
	found = [ROOT]
	if REPOS.is_dir():
		found.extend(sorted(p for p in REPOS.iterdir() if (p / "mise.toml").is_file()))
	return found


def label(where: pathlib.Path) -> str:
	return "workspace" if where == ROOT else f"repos/{where.name}"


def installed(where: pathlib.Path) -> list[tuple[str, str]]:
	"""(tool, version) for the tools this directory's own mise.toml declares."""
	result = subprocess.run(
		["mise", "ls", "--current", "--json"], cwd=where, capture_output=True, text=True
	)
	if result.returncode != 0:
		return []
	own = str((where / "mise.toml").resolve())
	found = []
	for tool, entries in json.loads(result.stdout).items():
		for entry in entries:
			if entry.get("source", {}).get("path") == own:
				found.append((tool, entry.get("version", "")))
	return sorted(found)


def active(where: pathlib.Path, tool: str) -> str | None:
	"""What `tool` resolves to in this directory, inherited or not."""
	result = subprocess.run(
		["mise", "ls", "--current", "--json"], cwd=where, capture_output=True, text=True
	)
	if result.returncode != 0:
		return None
	for entry in json.loads(result.stdout).get(tool, []):
		return entry.get("version")
	return None


def derived(where: pathlib.Path) -> list[tuple[pathlib.Path, str, str]]:
	"""(file, written, resolved) for the files an outside build reads, where they disagree.

	These restate a version whose home is a mise.toml. They exist because Cloudflare and every
	other outside build reads them and has never heard of mise, so they are written from that
	pin rather than maintained -- `up` rewrites them, `check` fails when something else moved
	one. Same shape as any other generated mirror here.
	"""
	found = []

	node_version = where / ".node-version"
	if node_version.is_file():
		running = active(where, "node")
		written = node_version.read_text().strip()
		if running and written != running:
			found.append((node_version, written, running))

	manifest = where / "package.json"
	if manifest.is_file():
		declared = json.loads(manifest.read_text()).get("packageManager", "")
		if declared.startswith("pnpm@"):
			running = active(where, "pnpm")
			written = declared.removeprefix("pnpm@")
			if running and written != running:
				found.append((manifest, written, running))
	return found


def write_derived(path: pathlib.Path, resolved: str) -> None:
	if path.name == ".node-version":
		path.write_text(f"{resolved}\n")
		return
	text = path.read_text()
	start = text.index('"packageManager"')
	end = text.index("\n", start)
	line = text[start:end]
	path.write_text(text[:start] + re.sub(r"pnpm@[^\"]+", f"pnpm@{resolved}", line) + text[end:])


def command_check() -> int:
	"""The files an outside build reads must name the version mise resolves."""
	problems = 0
	for where in configured():
		for path, written, resolved in derived(where):
			print(f"{label(where)}: {path.name} says {written}, mise resolves {resolved}")
			problems += 1
	if problems:
		print("    an outside build reads these; nothing out there has heard of mise")
		print("    `mise run update` rewrites them")
	else:
		print("the versions an outside build reads agree with mise")
	return 1 if problems else 0


def survey() -> list[tuple[pathlib.Path, str, str, str | None]]:
	"""(where, tool, installed, stable) for everything declared here."""
	rows = []
	for where in configured():
		for tool, version in installed(where):
			rows.append((where, tool, version, stable(tool)))
	return rows


def report(rows) -> tuple[int, int, int]:
	behind = ahead = unknown = 0
	for where, tool, version, current in rows:
		if current is None:
			print(f"{label(where):<14} {tool:<10} {version:<12} no stable channel to compare")
			unknown += 1
		elif version == current:
			continue
		elif series(version) != series(current):
			print(f"{label(where):<14} {tool:<10} {version:<12} -> {current} across a pin")
			behind += 1
		elif tuple(version.split(".")) > tuple(current.split(".")):
			print(f"{label(where):<14} {tool:<10} {version:<12} is AHEAD of stable {current}")
			ahead += 1
		else:
			print(f"{label(where):<14} {tool:<10} {version:<12} -> {current}")
			behind += 1
	return behind, ahead, unknown


def command_outdated() -> int:
	behind, ahead, _ = report(survey())
	if not behind and not ahead:
		print("every tool is on its publisher's stable release")
	elif ahead:
		print("\nA version ahead of stable is on a prerelease line. Pin it down to the stable one.")
	return 0


def command_up() -> int:
	moved = []
	for where in configured():
		before = dict(installed(where))
		subprocess.run(["mise", "upgrade", "--local"], cwd=where, check=True)
		after = dict(installed(where))
		for tool, was in before.items():
			if after.get(tool) != was:
				moved.append((label(where), tool, was, after.get(tool, "?")))

	# Written from the pins rather than maintained: whatever the toolchain moved to, the files
	# an outside build reads say so without anybody remembering to edit them.
	rewritten = []
	for where in configured():
		for path, _, resolved in derived(where):
			write_derived(path, resolved)
			rewritten.append((label(where), path.name, resolved))

	print()
	if rewritten:
		for place, name, resolved in rewritten:
			print(f"{place:<14} {name:<16} rewritten to {resolved}")
	if moved:
		for place, tool, was, now in moved:
			print(f"{place:<14} {tool:<10} {was} -> {now}")
		print("\nRun each repository's verify before trusting this; a toolchain move is a change.")
	else:
		print("everything is current within its pins")

	# Last, after a separator: this is the part a person has to act on, and an install log is
	# long enough to bury it.
	rows = [r for r in survey() if r[3] is not None and r[2] != r[3]]
	if rows:
		print("\n" + "-" * 72)
		print("Against each publisher's stable channel:\n")
		report(rows)
		print("\n  a pin is crossed by editing [tools]; nothing here does it for you")
	return 0


def main(argv: list[str]) -> int:
	action = argv[0] if argv else None
	if action == "check":
		return command_check()
	if action == "outdated":
		return command_outdated()
	if action == "up":
		return command_up()
	raise fail("usage: tools check | outdated | up")


if __name__ == "__main__":
	try:
		raise SystemExit(main(sys.argv[1:]))
	except subprocess.CalledProcessError as error:
		raise SystemExit(f"error: {' '.join(error.cmd)} failed") from error
