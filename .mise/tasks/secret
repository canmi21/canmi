#!/usr/bin/env fish
#MISE description="Type secrets into a repository's, a machine's or a platform's secrets.json, never shown: `secret <repo>[/machines/<m> | /platforms/<p>] [--from <file>] <NAME>...`"
#MISE raw=true
# Each value is read without echo and handed to sops on stdin. See docs/toolchain.md, "A secret is
# typed in, never written down".

set -l root (path resolve (status dirname)/../..)

argparse 'from=+' -- $argv
or exit 2

if test (count $argv) -lt 2
	echo "usage: mise run secret <repo>[/machines/<m> | /platforms/<p>] [--from <file>] <NAME>..." >&2
	exit 2
end

set -l repo $argv[1]
set -l names $argv[2..]
set -l file (path resolve -- $root/repos/$repo/secrets.json)

if not string match -q -- "$root/repos/*" $file
	echo "secret: $repo is not under repos/" >&2
	exit 2
end
if not test -f $file
	echo "secret: $file does not exist" >&2
	exit 1
end
# A machine's or a platform's secrets are named as sops-nix reads them, in lowercase and hyphens.
set -l form '^[A-Z][A-Z0-9_]*$'
set -l described "capitals and underscores"
if string match -qir -- '/(machines|platforms)/[^/]+/secrets\.json$' $file
	set form '^[a-z][a-z0-9-]*$'
	set described "lowercase and hyphens, as a machine's secret is"
end
for name in $names
	if not string match -qr $form -- $name
		echo "secret: `$name` is not a name in $described" >&2
		exit 1
	end
end
if set -q _flag_from
	if test (count $_flag_from) -ne 1 -o (count $names) -ne 1
		echo "secret: --from gives one value, so it is given once and takes one name" >&2
		exit 2
	end
	# A relative path is the one typed, read from where mise was started rather than the root.
	if not string match -q -- '/*' $_flag_from; and set -q MISE_ORIGINAL_CWD
		set _flag_from $MISE_ORIGINAL_CWD/$_flag_from
	end
	if not test -f $_flag_from -a -r $_flag_from
		echo "secret: $_flag_from is not a file to read" >&2
		exit 1
	end
	if not test -s $_flag_from
		echo "secret: $_flag_from is empty" >&2
		exit 1
	end
	# jq reads text, so bytes that are not UTF-8 would be changed rather than kept.
	if not iconv -f UTF-8 -t UTF-8 <$_flag_from >/dev/null 2>&1
		echo "secret: $_flag_from is not UTF-8 text" >&2
		exit 1
	end
end

echo "secret: $file"
set -l changed 0
for name in $names
	# A name is readable in the encrypted file; only its value is not.
	if jq -e --arg key $name 'has($key)' $file >/dev/null
		read -l -P "  $name is set already; replace it? [y/N] " answer
		if not string match -qi y -- $answer
			echo "  $name kept"
			continue
		end
	end
	if set -q _flag_from
		# The file goes to sops whole, its lines kept, and is never read into the shell.
		if not jq -Rs . <$_flag_from | sops set --value-stdin $file "[\"$name\"]"
			echo "secret: sops could not set $name" >&2
			exit 1
		end
		echo "  $name set from $_flag_from, "(wc -c <$_flag_from | string trim)" bytes"
	else
		read -l -s -P "  $name: " value
		if test -z "$value"
			echo "  $name skipped, nothing typed"
			continue
		end
		if not printf %s $value | jq -Rs . | sops set --value-stdin $file "[\"$name\"]"
			echo "secret: sops could not set $name" >&2
			exit 1
		end
		echo "  $name set, "(string length -- $value)" characters"
		set -e value
	end
	set changed (math $changed + 1)
end

if test $changed -gt 0
	echo "secret: $changed set in $file, still encrypted; it is committed as it is"
end
