#!/usr/bin/env fish
#MISE description="Type secrets into a repository's secrets.json, never shown: `secret <repo> <NAME>...`"
#MISE raw=true
# Each value is read without echo and handed to sops on stdin, so it is in no argument, no process
# listing, no shell history and no file in plain text. See spec/toolchain.md, "A secret is typed
# in, never written down".

set -l root (path resolve (status dirname)/../..)

if test (count $argv) -lt 2
	echo "usage: mise run secret <repo> <NAME>..." >&2
	exit 2
end

set -l repo $argv[1]
set -l names $argv[2..]
set -l file $root/repos/$repo/secrets.json

if not test -f $file
	echo "secret: $file does not exist" >&2
	exit 1
end
for name in $names
	if not string match -qr '^[A-Z][A-Z0-9_]*$' -- $name
		echo "secret: `$name` is not a name in capitals and underscores" >&2
		exit 1
	end
end

echo "secret: $file"
set -l changed 0
for name in $names
	# A name is readable in the encrypted file; only its value is not.
	if jq -e --arg key $name 'has($key)' $file >/dev/null
		read -l -P "  $name is set already; replace it? [y/N] " answer
		if not string match -qi y -- $answer
			echo "  $name kept"
			continue
		end
	end
	read -l -s -P "  $name: " value
	if test -z "$value"
		echo "  $name skipped, nothing typed"
		continue
	end
	if not printf %s $value | jq -Rs . | sops set --value-stdin $file "[\"$name\"]"
		echo "secret: sops could not set $name" >&2
		exit 1
	end
	echo "  $name set, "(string length -- $value)" characters"
	set -e value
	set changed (math $changed + 1)
end

if test $changed -gt 0
	echo "secret: $changed set in $file, still encrypted; it is committed as it is"
end
