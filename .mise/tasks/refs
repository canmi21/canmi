#!/usr/bin/env python3
#MISE description="Check that the rules' references resolve: `refs [--json]`"
"""Validate how this repository refers to its own files. Three checks, all objective:

1. A markdown link in a doc points at a file that exists.
2. A `spec/**/*.md`, or a project's `repos/<name>/**/*.md`, cited from code or the text beside
   it, exists -- unless the project is not cloned, which is a note and not a failure.
3. A section name quoted beside such a citation, in code or in another doc, exists in it.

All three break silently on rename, and AGENTS.md is the one file a zero-context agent reads, so
a citation rotting there costs the most. The three rules themselves are in `refs_check.py` beside
this file, which lattice's `refs` imports too; what stays here is what is this repository's alone.

Run with --json to emit the pair graph instead of validating.
"""

from __future__ import annotations

import json
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parents[2]
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from refs_check import (  # noqa: E402
	COMMENT_WRAP,
	DOC_ANCHOR,
	DOC_TAIL,
	PROSE_WRAP,
	ROOT_DOCS,
	citing_files,
	code_anchor,
	dead_anchors,
	dead_links,
	pair_graph,
	tracked,
)

CODE_SUFFIXES = {
	".ts",
	".js",
	".mjs",
	".rs",
	".py",
	".toml",
	".json",
	".jsonc",
	".yaml",
	".yml",
}
# The lockfile is generated, enormous, and cites nothing. `repos/` needs no entry: it is
# gitignored, so the listing below never offers it.
SKIP_FILES = {"pnpm-lock.yaml"}

# Code cites this repository's rules and, one directory down, a project's; both resolve at the
# root. The project segment is spelled apart from the path so that `repos/<name>/**/*.md` stays
# unmatched beside `spec/<f>.md` -- spec/agent-protocol.md, "In code a spec path is a citation,
# so an illustration is spelled to fail".
CITED = rf"(?:repos/[a-z0-9-]+/{DOC_TAIL}|spec/{DOC_TAIL})"
CODE_REF = re.compile(CITED)
# The root docs join the anchor check and nothing else: a bare `AGENTS.md` in code is a value in
# a config list far more often than a pointer, and a rule over those is the tool checking its own
# configuration, which already fails loudly when it is wrong.
CODE_ANCHOR = code_anchor(rf"{CITED}|{ROOT_DOCS}")


def files() -> list[pathlib.Path]:
	return tracked(ROOT, skip_files=SKIP_FILES)


def docs() -> list[pathlib.Path]:
	"""Every tracked markdown file, taken from git rather than from a glob.

	A glob has to name where docs live, and then a doc written somewhere else is unchecked.
	Symlinks drop out: one would be a second name for a doc already read, reporting each of its
	citations twice.
	"""
	return sorted(p for p in files() if p.suffix == ".md" and not p.is_symlink())


def resolve(path: pathlib.Path, cited: str) -> pathlib.Path | None:
	"""Where a citation points, or None when nothing holds it.

	A doc names a neighbour -- `toolchain.md` from inside `spec/` -- which resolves against its
	own directory. Code names `spec/<f>.md`, or a project's `repos/<name>/<f>.md`, from wherever
	it sits, and that means the root: this repository is the top of the rule hierarchy, with
	nothing above to walk up into. Trying both in turn reads each shape the way its author meant.
	"""
	for candidate in (path.parent / cited, ROOT / cited):
		if candidate.exists():
			return candidate
	return None


def uncloned(target: pathlib.Path) -> bool:
	"""Whether a citation lands in a project this machine has not cloned.

	AGENTS.md, "A project's tasks are reached by path": not being cloned is a warning, not an
	error, so a machine holding one project still works. A file missing from a project that is
	cloned stays an error, because there the citation really is dead.
	"""
	try:
		parts = target.resolve().relative_to(ROOT).parts
	except ValueError:
		return False
	return len(parts) > 1 and parts[0] == "repos" and not (ROOT / "repos" / parts[1]).is_dir()


def main() -> int:
	citing = citing_files(files(), CODE_SUFFIXES)
	graph = pair_graph(ROOT, citing, CODE_REF)

	if "--json" in sys.argv:
		print(json.dumps(graph))
		return 0

	written = docs()
	sources = [(path, CODE_ANCHOR, COMMENT_WRAP) for path in citing]
	sources += [(doc, DOC_ANCHOR, PROSE_WRAP) for doc in written]

	dead, absent = dead_links(ROOT, written, uncloned)
	stale, anchors = dead_anchors(ROOT, sources, resolve)

	gone = {spec: cited for spec, cited in sorted(graph.items()) if not (ROOT / spec).is_file()}
	absent += [spec for spec in gone if uncloned(ROOT / spec)]

	problems = [f"dead link: {d}" for d in dead]
	problems += [
		f"missing spec cited by {', '.join(cited)}: {spec}"
		for spec, cited in gone.items()
		if not uncloned(ROOT / spec)
	]
	problems += [f"missing section: {s}" for s in stale]

	if problems:
		print("Reference check failed:\n", file=sys.stderr)
		for problem in problems:
			print(f"  {problem}", file=sys.stderr)
		return 1

	linked = sum(len(v) for v in graph.values())
	note = f", {len(absent)} into projects not cloned here" if absent else ""
	print(
		f"references OK: {len(written)} docs, {linked} code -> spec citations, "
		f"{anchors} quoted sections{note}"
	)
	return 0


if __name__ == "__main__":
	sys.exit(main())
