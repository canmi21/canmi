#!/usr/bin/env python3
#MISE description="Check that the rules' references resolve: `refs [--json]`"
"""Validate how this repository refers to its own files. Three checks, all objective:

1. A markdown link in a doc points at a file that exists.
2. A `spec/**/*.md` cited from code, or from the extensionless text beside it, exists.
3. A section name quoted beside such a citation, in code or in another doc, exists in it.

All three break silently on rename, and CLAUDE.md is the one file a zero-context agent reads,
so a citation rotting there costs the most. lattice's `refs` runs the same three plus a URL
rule of its own; this one duplicates rather than imports, because a machine that cloned a
different project -- or none -- must still be able to check the workspace.

Run with --json to emit the pair graph instead of validating.
"""

from __future__ import annotations

import json
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[2]
CODE_SUFFIXES = {
	".ts",
	".js",
	".mjs",
	".rs",
	".py",
	".toml",
	".json",
	".jsonc",
	".yaml",
	".yml",
}
# The lockfile is generated, enormous, and cites nothing. `repos/` needs no entry: it is
# gitignored, so the listing below never offers it.
SKIP_FILES = {"pnpm-lock.yaml"}

MD_LINK = re.compile(r"\[[^\]]*\]\(([^)]+)\)")
DOC_PATH = r"[a-z0-9-]+(?:/[a-z0-9-]+)*\.md"
SPEC_REF = re.compile(rf"spec/{DOC_PATH}")
# A citation may name a section: `spec/<f>.md, "Name"` or `spec/<f>.md ("Name")`. The quote need
# not sit against it, but it may not cross a full stop or a semicolon, or a sentence quoting
# something else is read as this one's anchor.
ANCHOR = r'[^".;\n]{0,60}?"(?P<anchor>[^"]{6,160})"'
CODE_ANCHOR = re.compile(rf"(?P<target>spec/{DOC_PATH}){ANCHOR}")
# A doc cites by markdown link or by bare path, and either may be relative to the citing file.
DOC_ANCHOR = re.compile(rf"(?:\[[^\]]*\]\()?(?P<target>(?:\.\./)*{DOC_PATH})\)?{ANCHOR}")
# An anchor may wrap, so continuation lines fold away before matching. `#` is here for
# `.gitignore` and `.gitattributes`, whose anchors wrap across it exactly as a docstring's do.
COMMENT_WRAP = re.compile(r"\n[ \t]*(?:\*|///|//!|//|#)?[ \t]*")
# Prose carries no comment markers, and a `*` opening a line is emphasis rather than one.
PROSE_WRAP = re.compile(r"\n\s*")
SPACES = re.compile(r"\s+")
NOT_WORD = re.compile(r"[^a-z0-9 ]")
FENCE = re.compile(r"```.*?```", re.S)
INLINE_CODE = re.compile(r"`[^`\n]+`")


def tracked() -> list[pathlib.Path]:
	"""Every file git knows about here, less the lockfile.

	The candidate set comes from git because `.gitignore` is already the one home of "this is
	not ours"; a second list can only drift from the first. It is also what keeps `repos/` out:
	each project below is a separate repository with its own gate, ignored by this one.
	"""
	listing = subprocess.run(
		["git", "-C", str(ROOT), "ls-files", "--cached", "--others", "--exclude-standard", "-z"],
		capture_output=True,
		text=True,
		check=True,
	)
	return [ROOT / name for name in listing.stdout.split("\0") if name and name not in SKIP_FILES]


def read(path: pathlib.Path) -> str:
	try:
		return path.read_text()
	except (OSError, UnicodeDecodeError):
		return ""


def docs() -> list[pathlib.Path]:
	"""Every tracked markdown file, taken from git rather than from a glob.

	A glob has to name where docs live, and then a doc written somewhere else is unchecked.
	Symlinks drop out: `AGENTS.md` is `CLAUDE.md` under a second name, and reading both would
	report every one of its citations twice.
	"""
	return sorted(p for p in tracked() if p.suffix == ".md" and not p.is_symlink())


def extensionless_text(path: pathlib.Path) -> bool:
	"""Whether a tracked file with no extension is text, and so can hold a citation.

	A shebang is the obvious tell and it is not enough: it finds the task scripts and misses
	`.gitignore` and `.gitattributes`, which cite without being executable. Decoding to text
	with no NUL in it covers both, and all it lets in besides costs a scan and nothing else.
	"""
	if path.suffix:
		return False
	body = read(path)
	return bool(body) and "\0" not in body


def citing_files() -> list[pathlib.Path]:
	"""Code, plus the extensionless text lying beside it.

	A suffix allowlist is blind to precisely the files a checker lives among, which is how nine
	citations of a spec file that never existed survived in lattice's. In any of these a
	path-shaped `spec/` string is a citation wherever it sits -- comment, docstring or printed
	message alike, since a dead citation shown to whoever fails a check is still dead.
	"""
	return [path for path in tracked() if path.suffix in CODE_SUFFIXES or extensionless_text(path)]


def without_code(text: str) -> str:
	"""Blank out fenced blocks and inline code, keeping line structure intact.

	A doc describing how a citation is spelled writes one inside backticks. That is an example
	of a link, not a link, and reading it as a target makes the rules unable to state themselves.
	"""
	text = FENCE.sub(lambda m: "\n" * m.group(0).count("\n"), text)
	return INLINE_CODE.sub(lambda m: " " * len(m.group(0)), text)


def resolve(base: pathlib.Path, cited: str) -> pathlib.Path | None:
	"""Where a citation points, or None when nothing holds it.

	Two shapes are written here. A doc names a neighbour -- `toolchain.md` from inside `spec/`,
	`spec/agent-protocol.md` from CLAUDE.md at the root -- which resolves against the citing
	file's own directory. Code names `spec/<f>.md` from wherever it sits, and that means the
	workspace root: this repository is the top of the rule hierarchy, with nothing above to
	walk up into. Trying both in turn reads each shape the way its author meant it.
	"""
	for candidate in (base / cited, ROOT / cited):
		if candidate.exists():
			return candidate
	return None


def uncloned(target: pathlib.Path) -> bool:
	"""Whether a citation lands in a project this machine has not cloned.

	CLAUDE.md, "A project's tasks are reached by path": not being cloned is a warning, not an
	error, so a machine holding one project still works. A file missing from a project that is
	cloned stays an error, because there the citation really is dead.
	"""
	try:
		parts = target.resolve().relative_to(ROOT).parts
	except ValueError:
		return False
	return len(parts) > 1 and parts[0] == "repos" and not (ROOT / "repos" / parts[1]).is_dir()


def doc_links() -> tuple[list[str], list[str]]:
	"""Markdown links that point at nothing, split from those aimed at an absent project."""
	dead: list[str] = []
	absent: list[str] = []
	for doc in docs():
		for match in MD_LINK.finditer(without_code(read(doc))):
			target = match.group(1)
			if target.startswith(("http://", "https://", "#", "mailto:")):
				continue
			landing = doc.parent / target.split("#")[0]
			if landing.exists():
				continue
			(absent if uncloned(landing) else dead).append(f"{doc.relative_to(ROOT)} -> {target}")
	return dead, absent


def pair_graph() -> dict[str, list[str]]:
	"""spec file -> the code files that cite it."""
	graph: dict[str, list[str]] = {}
	for path in citing_files():
		rel = str(path.relative_to(ROOT))
		for spec in sorted(set(SPEC_REF.findall(read(path)))):
			graph.setdefault(spec, []).append(rel)
	return graph


BODIES: dict[pathlib.Path, str] = {}


def flatten(text: str) -> str:
	"""Text reduced to its lowercase words, every other character becoming a space.

	Applied to the heading's file and to the anchor alike, so a heading spelling a name in
	backticks or separating a clause with an em dash still matches the citation quoting it.
	Collapse last, not first: dropping `` `spec/` `` leaves three spaces where the citation's
	`spec/` leaves two, and a squeeze done beforehand never sees either.
	"""
	return SPACES.sub(" ", NOT_WORD.sub(" ", text.lower())).strip()


def flattened(path: pathlib.Path | None) -> str | None:
	"""One file flattened and kept, or None when it is not there."""
	if path is None or not path.is_file():
		return None
	if path not in BODIES:
		BODIES[path] = flatten(read(path))
	return BODIES[path]


def dead_anchors() -> tuple[list[str], int]:
	"""Section names quoted from code or from another doc that the named file no longer holds.

	A file existing does not mean the section named inside it still does, so a heading is part
	of the interface. Read raw rather than through `without_code`: an anchor quotes its heading
	verbatim, inline code and all. A target that is not there is the check above's to report.
	"""
	dead: list[str] = []
	seen = 0
	sources = [(path, CODE_ANCHOR, COMMENT_WRAP) for path in citing_files()]
	sources += [(doc, DOC_ANCHOR, PROSE_WRAP) for doc in docs()]
	for path, pattern, wrap in sources:
		for match in pattern.finditer(wrap.sub(" ", read(path))):
			cited = match.group("target")
			body = flattened(resolve(path.parent, cited))
			if body is None:
				continue
			seen += 1
			if flatten(match.group("anchor")) not in body:
				dead.append(f'{path.relative_to(ROOT)} -> {cited} ("{match.group("anchor")}")')
	return dead, seen


def main() -> int:
	graph = pair_graph()

	if "--json" in sys.argv:
		print(json.dumps(graph))
		return 0

	dead, absent = doc_links()
	stale, anchors = dead_anchors()

	problems = [f"dead link: {d}" for d in dead]
	problems += [
		f"missing spec cited by {cited}: {spec}"
		for spec, cited in sorted(graph.items())
		if not (ROOT / spec).is_file()
		for cited in [", ".join(cited)]
	]
	problems += [f"missing section: {s}" for s in stale]

	if problems:
		print("Reference check failed:\n", file=sys.stderr)
		for problem in problems:
			print(f"  {problem}", file=sys.stderr)
		return 1

	linked = sum(len(v) for v in graph.values())
	note = f", {len(absent)} into projects not cloned here" if absent else ""
	print(
		f"references OK: {len(docs())} docs, {linked} code -> spec citations, "
		f"{anchors} quoted sections{note}"
	)
	return 0


if __name__ == "__main__":
	sys.exit(main())
