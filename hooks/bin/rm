#!/usr/bin/python3
# First on an agent's PATH through mise.toml; the policy is hooks/rm_guard.py.
import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

import rm_guard  # noqa: E402

sys.exit(rm_guard.main(sys.argv[1:]))
