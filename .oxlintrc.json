{
	// oxlint comes from mise, so its schema is fetched rather than read from node_modules.
	"$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "import", "oxc"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn",
		// style overlaps oxfmt; pedantic and nursery are opinion. See spec/lint-format.md.
		"style": "off",
		"pedantic": "off",
		"nursery": "off"
	},
	"ignorePatterns": [
		"**/dist/**",
		"**/build/**",
		"**/node_modules/**",
		"**/.svelte-kit/**",
		"**/.wrangler/**",
		"**/worker-configuration.d.ts",
		// Vendored source is its authors' to lint, spec/vendor.md.
		"**/vendor/**",
		"data/**"
	],
	"rules": {
		// oxfmt rewrites U+00A0 itself.
		"no-irregular-whitespace": "off",

		// Paraglide's dotted keys are checked by the compiler, which names the typo.
		"import/namespace": "off",

		// A side-effect CSS import is how every app loads its styles.
		"import/no-unassigned-import": "off",

		// import/no-empty-named-blocks reports the same defect.
		"unicorn/require-module-specifiers": "off"
	},
	"env": {
		"builtin": true
	}
}
