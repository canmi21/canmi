/**
 * The reference page under model/reference, the rules written out of the model, never by hand.
 * `mise run docs` writes it and the generated part holds it to what the model says.
 */
let directory = "model/reference"
let task = "mise run docs"

/** The topics in the order rules.res joins them, each with the title its page section carries. */
let topics: array<(string, array<Rule.t>)> = [
  ("Commits", Commits.rules),
  ("Naming", Naming.rules),
  ("Layout", Layout.rules),
  ("Toolchain", Toolchain.rules),
  ("Code", Code.rules),
  ("Format", Format.rules),
  ("Voice", Voice.rules),
  ("Readme", Readme.rules),
  ("Planning", Planning.rules),
  ("Delegation", Delegation.rules),
]

let opening = what =>
  `<!-- Generated by \`${task}\` from the model, ${what}. Do not edit; change the model and run it. -->`

/** A doc path as a link from model/reference, a file under the workspace. */
let linked = (doc: string) => `[${doc}](../../${doc})`

let heldBy = (held: Rule.held) =>
  switch held {
  | Check(part) => `check part \`${part}\``
  | Hook(path) => `hook \`${path}\``
  | Gate(name) => `gate \`${name}\``
  | Pending(owed) => `pending, owed: ${owed}`
  }

let ruleBlock = (rule: Rule.t) => [
  `### ${rule.name}`,
  "",
  rule.says ++ (rule.says->String.endsWith(".") ? "" : "."),
  "",
  `- doc: ${linked(rule.doc)}`,
  `- held by: ${heldBy(rule.held)}`,
  "",
]

let rules = (topics: array<(string, array<Rule.t>)>): string => {
  let all = topics->Array.flatMap(((_, rules)) => rules)
  let pending = all->Array.filter(rule =>
    switch rule.held {
    | Pending(_) => true
    | _ => false
    }
  )
  Array.flat([
    [
      opening("model/rules"),
      "",
      "# Rules",
      "",
      `${Int.toString(all->Array.length)} rules, ${Int.toString(
          pending->Array.length,
        )} pending a check.`,
      "",
    ],
    topics->Array.flatMap(((title, rules)) =>
      Array.flat([[`## ${title}`, ""], rules->Array.flatMap(ruleBlock)])
    ),
  ])
  ->Array.join("\n")
  ->String.trimEnd ++ "\n"
}

/** Each page's path under the directory with the text the model gives it. */
let pages = (): array<(string, string)> => [("rules.md", rules(topics))]

let write = (~root) => {
  Node.mkdirAll(Node.join([root, directory]))
  pages()->Array.forEach(((name, text)) =>
    Node.writeFileSync(Node.join([root, directory, name]), text)
  )
}

/** Each page that is missing or differs from what the model gives, naming the task. */
let found = (~root): array<string> =>
  pages()->Array.filterMap(((name, text)) => {
    let path = Node.join([root, directory, name])
    let have = Node.existsSync(path) ? Some(Node.readFileSync(path)) : None
    have == Some(text)
      ? None
      : Some(`${directory}/${name} is not what the model gives; run ${task}`)
  })

if Node.isMain {
  write(~root=Registry.root)
}
