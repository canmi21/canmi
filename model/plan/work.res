/**
 * What is to be done and where it stands, RFC 8q1af. Whether an item is done is derived from what
 * `holds` names, never written, and `after` names what must be done first.
 */
type until =
  /** Due once the RFC of this id is landed or declined. */
  | Closes(string)
  /** Due when the author says. */
  | Author

type holds =
  /** Nothing holds it yet, and what it needs. */
  | Owes(string)
  /** A part of the check being brought in, which warns until it is moved to Holds. */
  | Landing(string)
  /** A part of the check that holds it, which refuses. */
  | Holds(string)
  /** Done while this commit is on the main of that repository, `workspace` or its registry path. */
  | Committed({repo: string, commit: string})
  /** Done by evidence no program can decide, dated yyyy-mm-dd. */
  | Observed({at: string, what: string})

type item = {
  id: string,
  says: string,
  /** Repositories by their path in repos/registry.toml, or `workspace`. */
  repos: array<string>,
  /** The ids of the items that must be done first. */
  after: array<string>,
  holds: holds,
  /** The RFC that recorded why. */
  why?: string,
  /** What a chore waits on besides `after`, listed in red at the end of every check. */
  waits?: until,
  /** The workspace's rules not held over `repos` while the item waits. */
  waives?: array<string>,
  /** `check --all` and `audit --all` pass over `repos` while the item waits. */
  pauses?: bool,
  /** What the item waits on from another repository, each `repository:name` of its `depends`. */
  needs?: array<string>,
  /** What the item delivers to others, each a name of its repository's `exports`. */
  delivers?: array<string>,
}

